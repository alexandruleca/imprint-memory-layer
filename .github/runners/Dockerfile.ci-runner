# The throwaway runners' image (jit-runners.sh): the upstream runner image
# with what every Linux CI job would otherwise install again, so an arm64 job
# under emulation skips about a quarter of an hour (docs/ci-runners.md).
#   - GitHub's Python 3.12 build in the tool cache, as setup-python installs
#     it. Not Ubuntu's python3.12: under arm64 emulation that one ran the
#     tests about four times slower (ADR 0119).
#   - /opt/imprint-ci: a venv of that Python holding the locked dependencies;
#     ci.yml uses it in place of setup-python, and its pip install then adds
#     only what the locks changed since this image was built
#   - Go from go.mod in the tool cache, where setup-go finds it
# A stale image is only slower. build-ci-runner.sh rebuilds it.
ARG RUNNER_IMAGE=myoung34/github-runner:2.338.2-ubuntu-noble
FROM ${RUNNER_IMAGE}

# The build's own setup.sh lays it out in the tool cache; ldconfig finds its
# libpython without the LD_LIBRARY_PATH setup-python would set.
ARG PYTHON_URL
RUN set -eu; \
    mkdir /tmp/python && curl -fsSL "$PYTHON_URL" | tar -xz -C /tmp/python; \
    (cd /tmp/python && bash ./setup.sh >/dev/null); \
    rm -rf /tmp/python; \
    dirname "$(ls -d "$AGENT_TOOLSDIRECTORY"/Python/3.12.*/*/lib/libpython3.12.so.1.0)" > /etc/ld.so.conf.d/imprint-python.conf; \
    ldconfig

COPY requirements/base.lock.txt requirements/cpu.lock.txt requirements/llm.lock.txt /tmp/imprint-requirements/
RUN "$(ls -d "$AGENT_TOOLSDIRECTORY"/Python/3.12.*/*/bin/python3.12)" -m venv /opt/imprint-ci \
    && /opt/imprint-ci/bin/python -m pip install --no-cache-dir --upgrade pip \
    && /opt/imprint-ci/bin/python -m pip install --no-cache-dir --require-hashes \
        -r /tmp/imprint-requirements/base.lock.txt \
        -r /tmp/imprint-requirements/cpu.lock.txt \
        -r /tmp/imprint-requirements/llm.lock.txt \
    && rm -rf /tmp/imprint-requirements

# setup-go's cache layout: go/<version>/<arch>/ and a <arch>.complete marker.
ARG GO_VERSION
ARG GO_SHA256
RUN set -eu; \
    case "$(dpkg --print-architecture)" in amd64) arch=x64 ;; arm64) arch=arm64 ;; esac; \
    dest="$AGENT_TOOLSDIRECTORY/go/$GO_VERSION/$arch"; \
    curl -fsSLo /tmp/go.tgz "https://go.dev/dl/go$GO_VERSION.linux-$(dpkg --print-architecture).tar.gz"; \
    echo "$GO_SHA256  /tmp/go.tgz" | sha256sum -c -; \
    mkdir -p "$dest"; \
    tar -xzf /tmp/go.tgz -C "$dest" --strip-components=1; \
    touch "$dest.complete"; \
    rm /tmp/go.tgz
