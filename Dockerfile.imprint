# All-in-one Imprint container: Go CLI + Python runtime + auto-spawned Qdrant
# + dashboard UI/API on :8420. Embedding model and Qdrant binary download on
# first use into the mounted /data volume so the image stays slim.
#
# Not the same as `Dockerfile` (the lightweight relay image). This one is for
# users who want to run imprint itself in a container — browse memories,
# ingest content via the MCP `ingest_content` tool or the API, and drive the
# CLI via `docker exec`.
#
# Python, system packages and the dependency venv come from the base image
# (Dockerfile.base), so a release rebuilds only what follows. The Image
# workflow passes the published base; locally, build the base first:
#   docker build -f Dockerfile.base -t imprint-base:local .
ARG BASE_IMAGE=imprint-base:local

# ── Stage 1: Go CLI binary ────────────────────────────────────────────
# The Go binary is static, so it is cross-compiled on the build machine: Go's
# compiler hangs under the qemu emulation an arm64 image would otherwise use.
FROM --platform=$BUILDPLATFORM golang:1.25-alpine AS go-builder
ARG VERSION=dev
ARG TARGETOS TARGETARCH
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build \
    -ldflags "-s -w -X main.version=${VERSION}" \
    -o /out/imprint .

# Build the dashboard from source; never ship the committed export. The static
# export is the same on every architecture, so it builds natively.
FROM --platform=$BUILDPLATFORM node:22-bookworm-slim AS dashboard-builder
WORKDIR /dashboard
COPY imprint/ui/package.json imprint/ui/package-lock.json ./
RUN npm ci
COPY imprint/ui/ ./
RUN npm run build

# ── Stage 2: Python runtime ───────────────────────────────────────────
FROM ${BASE_IMAGE}

ARG VERSION=dev
ENV IMPRINT_VERSION=${VERSION} \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    IMPRINT_DATA_DIR=/data \
    PYTHONPATH=/app \
    PATH=/app/.venv/bin:$PATH \
    HF_HOME=/data/hf-cache \
    XDG_CACHE_HOME=/data/cache

WORKDIR /app
# All profiles' requirements, as an installation has them; the base installed
# the container's.
COPY requirements/ /app/requirements/

# Imprint Python package + Go binary + entrypoint.
COPY imprint/ /app/imprint/
COPY --from=dashboard-builder /dashboard/out/ /app/imprint/ui/out/
COPY --from=go-builder /out/imprint /app/bin/imprint
COPY LICENSE /app/LICENSE
COPY docker/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN ln -s /app/bin/imprint /usr/local/bin/imprint \
    && chmod +x /app/bin/imprint /usr/local/bin/entrypoint.sh

# Run as non-root. /data and /workspace are owned by this user so volume
# mounts from the host Just Work (user overrides with -u if they prefer).
RUN useradd --create-home --uid 1000 imprint \
    && mkdir -p /data /workspace \
    && chown imprint:imprint /data /workspace

USER imprint
WORKDIR /workspace

EXPOSE 8420

# /health is provided by the FastAPI app (status endpoint).
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8420/api/version || exit 1

# tini reaps Qdrant + uvicorn children cleanly on SIGTERM.
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint.sh"]
CMD ["api"]
