{
  "name": "imprint-ui",
  "version": "0.1.0",
  "description": "Imprint memory dashboard",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build:win": "electron-builder --win --x64",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "tech.brightspaces.imprint",
    "productName": "Imprint",
    "copyright": "Copyright © 2025 Brightspaces",
    "directories": {
      "output": "../dist/electron"
    },
    "files": [
      "main.js",
      "preload.js",
      "navigation.js",
      "voice-permissions.js",
      "companion.js",
      "service.js",
      "startup.html",
      "startup.css",
      "startup.js",
      "assets/**"
    ],
    "extraMetadata": {
      "main": "main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "../site/public/logo.svg"
    },
    "portable": {
      "artifactName": "imprint-ui.exe"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "../site/public/logo.svg",
      "category": "public.app-category.developer-tools",
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist",
      "extendInfo": { "NSMicrophoneUsageDescription": "Imprint uses your microphone for conversations with your local voice companion when you enable it." }
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "category": "Development",
      "artifactName": "imprint-ui.AppImage"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "deleteAppDataOnUninstall": false
    }
  }
}
