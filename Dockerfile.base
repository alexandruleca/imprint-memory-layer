# The Imprint image's base: Python, system packages and the dependency venv,
# everything that changes only with this file or a lock file. Dockerfile.imprint
# adds Imprint itself on top.
#
# The Image workflow publishes it as ghcr.io/alexandruleca/imprint-base:<hash>,
# the tag scripts/base-image-tag.sh derives from this file and the lock files,
# and builds it only when that tag does not exist yet: the arm64 install runs
# under qemu emulation and takes about 35 minutes, a release image minutes.
#
# Locally: docker build -f Dockerfile.base -t imprint-base:local .
# The Python image is pinned by digest, so the base changes only with a commit;
# move the digest to take Debian and Python updates.
FROM python:3.12-slim@sha256:aa943ce411423c7582288f18707ff66eddcbaeb510502d747a72aeb34f30d159

ENV PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates curl libgomp1 tini \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Python deps: the base requirements with the CPU ONNX Runtime (OCR, privacy
# filter), plus the llama.cpp binding, which runs embeddings, the tagger and
# the `local` chat provider (ADR 0086). The binding installs from upstream's
# prebuilt Linux CPU wheel (ADR 0035): containers get no GPU.
COPY requirements/base.lock.txt requirements/cpu.lock.txt requirements/llm.lock.txt /app/requirements/
RUN python -m venv /app/.venv \
    && /app/.venv/bin/pip install --no-cache-dir --require-hashes -r /app/requirements/base.lock.txt -r /app/requirements/cpu.lock.txt -r /app/requirements/llm.lock.txt

# The user Imprint runs as. Dockerfile.imprint switches to root to add
# Imprint and back to this user, so neither image runs as root.
RUN useradd --create-home --uid 1000 imprint
USER imprint
