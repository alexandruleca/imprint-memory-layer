#!/bin/bash
# Shortcut target for /Applications/Imprint.app.
#
# Responsibility: on first launch, show a small AppleScript dialog asking
# for the install profile (CPU/GPU) and whether to ship the local LLM
# tagger, then open Terminal.app running `imprint bootstrap` + `imprint
# setup` so the user sees uv's progress. On subsequent launches, just call
# `imprint ui open` and exit.
#
# .pkg's postinstall no longer does any heavy bootstrapping — it only fixes
# quarantine xattrs, chmod-s the binaries, and symlinks /usr/local/bin/imprint.
set -uo pipefail

APP_DIR="$(cd "$(dirname "$0")/.." && pwd)"
INSTALL_DIR="$APP_DIR/Resources/imprint"
HOME_DIR="${HOME:-$(eval echo ~$(id -un))}"
WRITABLE_HOME="$HOME_DIR/.local/share/imprint"

# The bundle itself is read-only, so the sentinel (plus venv + data) lives
# in the writable mirror managed by platform.MutableBaseDir in the Go side.
SENTINEL="$WRITABLE_HOME/.first-run.done"
BIN="$INSTALL_DIR/bin/imprint"
UV="$INSTALL_DIR/bin/uv"

show_error() {
    local title="$1"; shift
    local msg="$*"
    osascript -e "display dialog \"$msg\" with title \"Imprint — $title\" buttons {\"OK\"} default button \"OK\" with icon stop" >/dev/null 2>&1 || true
    echo "[x] $title: $msg" >&2
}

# Profile is always "cpu" on macOS: NVIDIA dropped Mac support long before
# Apple Silicon, and Metal/MPS backends are not wired into Imprint's ORT
# stack yet. So we skip the profile question entirely and only ask about
# the optional local LLM tagger. If Metal support lands upstream, this is
# the one place to flip.
prompt_profile() {
    # Returns: "cpu|<with-llm>" where with-llm=1|0.
    local llm_choice
    llm_choice=$(osascript <<'APPLESCRIPT' 2>/dev/null || echo "0"
set dlg to display dialog "Install the local LLM tagger (llama-cpp-python, ~200 MB)?

Skip this if you only want embeddings + MCP search. You can add it later with 'imprint profile add-llm'." with title "Imprint - Local LLM tagger" buttons {"Skip", "Install"} default button "Skip" cancel button "Skip"
if button returned of dlg is "Install" then
    return "1"
else
    return "0"
end if
APPLESCRIPT
)
    echo "cpu|${llm_choice}"
}

run_bootstrap_in_window() {
    local profile="$1"
    local with_llm="$2"
    local helper="$APP_DIR/Contents/MacOS/imprint-setup-helper"

    if [ -x "$helper" ]; then
        # exec replaces this launcher process with the helper, so Imprint.app
        # stays active in the Dock while the setup window is shown.
        exec "$helper" "$BIN" "$WRITABLE_HOME" "$profile" "$with_llm"
        # exec only returns on failure — fall through to Terminal fallback.
    fi

    # Fallback: no compiled helper present (local dev builds) or exec failed.
    # exec only returns on failure, so reaching here from the helper path means
    # the binary couldn't launch (Gatekeeper block, missing dylib, wrong arch).
    local llm_flag="--no-llm"
    [ "$with_llm" = "1" ] && llm_flag="--with-llm"
    mkdir -p "$WRITABLE_HOME"
    local cmd="\"$BIN\" bootstrap --profile $profile $llm_flag --non-interactive && \"$BIN\" setup && mkdir -p \"$WRITABLE_HOME\" && touch \"$SENTINEL\" && echo && echo '[+] Imprint is ready — press Enter to close this window' && read"
    if ! osascript 2>/tmp/imprint-launcher-err.log <<APPLESCRIPT
tell application "Terminal"
    activate
    do script "clear; echo '=== Imprint first-run setup ==='; echo 'Profile: $profile'; echo 'LLM: $with_llm'; echo; $cmd"
end tell
APPLESCRIPT
    then
        local err_detail
        err_detail="$(cat /tmp/imprint-launcher-err.log 2>/dev/null | head -3)"
        show_error "Setup failed" "Could not open a Terminal window to run first-run setup.

$err_detail

Open Terminal.app manually and run:
  imprint bootstrap --profile $profile $llm_flag --non-interactive
  imprint setup"
    fi
}

if [ ! -x "$BIN" ]; then
    show_error "Missing binary" "Imprint binary not found at $BIN. Reinstall from https://imprintmcp.alexandruleca.com/download."
    exit 1
fi
if [ ! -x "$UV" ]; then
    show_error "Missing uv" "Bundled uv not found at $UV. Reinstall from https://imprintmcp.alexandruleca.com/download."
    exit 1
fi

# A stale sentinel (e.g. left over from a prior install whose venv got
# wiped, or an aborted bootstrap that touched the sentinel too eagerly)
# would otherwise send us straight to `ui open`, which then fails with
# "venv not found". Gate the sentinel on the venv actually existing.
VENV_PY="$WRITABLE_HOME/.venv/bin/python"
if [ ! -f "$SENTINEL" ] || [ ! -x "$VENV_PY" ]; then
    [ -f "$SENTINEL" ] && rm -f "$SENTINEL"
    IFS='|' read -r PROFILE WITH_LLM <<< "$(prompt_profile)"
    # run_bootstrap_in_window execs the helper (replacing this process) or
    # opens Terminal.app as fallback, then exits.
    run_bootstrap_in_window "${PROFILE:-cpu}" "${WITH_LLM:-0}"
    exit 0
fi

# `imprint ui open` boots the Qdrant daemon + UI server and opens the
# browser. The launcher itself exits immediately — services keep running.
"$BIN" ui open >/dev/null 2>&1 &
disown 2>/dev/null || true
exit 0
