---
const year = new Date().getFullYear();
---

<footer class="border-t border-[color:var(--color-border)]">
  <div class="wrap py-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-4 text-sm">
    <div>
      <div class="flex items-center gap-2 mb-3">
        <img src="/logo.svg" alt="" width="22" height="22" />
        <span class="font-semibold">Imprint</span>
      </div>
      <p class="text-[color:var(--color-text-muted)]">
        One persistent memory for your AI coding agents, shared across tools, machines and teammates. Local by default.
      </p>
    </div>
    <div>
      <div class="font-semibold mb-3">Product</div>
      <ul class="space-y-2 text-[color:var(--color-text-muted)]">
        <li><a href="/#benefits" class="hover:text-ink">Why Imprint</a></li>
        <li><a href="/#sync" class="hover:text-ink">Sync &amp; share</a></li>
        <li><a href="/#architecture" class="hover:text-ink">How it works</a></li>
        <li><a href="/benchmarks" class="hover:text-ink">Benchmarks</a></li>
        <li><a href="/#install" class="hover:text-ink">Install</a></li>
        <li><a href="/faq" class="hover:text-ink">FAQ</a></li>
      </ul>
    </div>
    <div>
      <div class="font-semibold mb-3">Docs</div>
      <ul class="space-y-2 text-[color:var(--color-text-muted)]">
        <li><a href="/installation" class="hover:text-ink">Installation</a></li>
        <li><a href="/mcp" class="hover:text-ink">MCP tools</a></li>
        <li><a href="/api" class="hover:text-ink">HTTP API</a></li>
        <li><a href="/architecture" class="hover:text-ink">Architecture</a></li>
        <li><a href="/sync" class="hover:text-ink">Sync</a></li>
        <li><a href="/configuration" class="hover:text-ink">Configuration</a></li>
      </ul>
    </div>
    <div>
      <div class="font-semibold mb-3">Project</div>
      <ul class="space-y-2 text-[color:var(--color-text-muted)]">
        <li><a href="https://github.com/alexandruleca/imprint-memory-layer" class="hover:text-ink">GitHub ↗</a></li>
        <li><a href="https://github.com/alexandruleca/imprint-memory-layer/releases" class="hover:text-ink">Releases ↗</a></li>
        <li><a href="/download" class="hover:text-ink">Desktop installers</a></li>
        <li><a href="https://github.com/alexandruleca/imprint-memory-layer/blob/main/LICENSE" class="hover:text-ink">License (Apache 2.0)</a></li>
      </ul>
    </div>
  </div>
  <div class="wrap pb-10 text-xs text-[color:var(--color-text-dim)]">
    © {year} Imprint contributors. Numbers on this page come from
    <a href="/benchmarks" class="underline hover:text-ink">reproducible benchmark runs</a>.
  </div>
</footer>
