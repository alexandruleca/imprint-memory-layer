---
import Icon from './Icon.astro';

const nextSteps = [
  { cmd: 'imprint setup all', body: 'wires every MCP host it finds' },
  { cmd: 'imprint ingest .', body: 'indexes the project you’re in' },
  { cmd: 'imprint ui', body: 'opens the dashboard on :8420' },
];

const tabs = [
  {
    id: 'unix',
    label: 'macOS / Linux',
    command: 'curl -fsSL https://raw.githubusercontent.com/alexandruleca/imprint-memory-layer/main/install.sh | bash',
    next: true,
  },
  {
    id: 'win',
    label: 'Windows',
    command: 'irm https://raw.githubusercontent.com/alexandruleca/imprint-memory-layer/main/install.ps1 | iex',
    next: true,
  },
  {
    id: 'docker',
    label: 'Docker',
    command: 'docker run -d -p 127.0.0.1:8420:8420 -v imprint-data:/data ghcr.io/alexandruleca/imprint:latest',
    hint: 'Dashboard and API on <code class="cmd">localhost:8420</code>. Ingest with <code class="cmd">docker exec</code> or the <code class="cmd">ingest_content</code> tool; IDE hosts still use the local stdio install. See the <a href="/docker" class="underline underline-offset-2 hover:text-white">Docker guide</a>.',
  },
  {
    id: 'relay',
    label: 'Sync relay',
    command: 'docker run -d -p 8430:8430 ghcr.io/alexandruleca/imprint-relay:latest',
    hint: 'Self-host the stateless sync relay, then point peers at it with <code class="cmd">imprint sync serve --relay your.host</code>. Put TLS in front of it; see the <a href="/docker" class="underline underline-offset-2 hover:text-white">Docker guide</a>.',
  },
];
---

<div class="card overflow-hidden">
  <div class="flex gap-1 p-1.5 border-b border-[color:var(--color-border)] overflow-x-auto" role="tablist" aria-label="Install method">
    {tabs.map((t, i) => (
      <button
        data-install-tab={t.id}
        class="px-4 py-2 text-sm font-medium whitespace-nowrap rounded-lg transition text-[color:var(--color-text-muted)] hover:text-white aria-selected:bg-white/[0.06] aria-selected:text-white"
        role="tab"
        aria-selected={i === 0 ? 'true' : 'false'}
        aria-controls={`install-panel-${t.id}`}
      >
        {t.label}
      </button>
    ))}
  </div>
  {tabs.map((t, i) => (
    <div
      id={`install-panel-${t.id}`}
      data-install-panel={t.id}
      class={`p-4 sm:p-6 ${i === 0 ? '' : 'hidden'}`}
      role="tabpanel"
    >
      <div class="flex items-center gap-2 rounded-xl border border-[color:var(--color-border-strong)] bg-[color:var(--color-bg)] p-1.5 pl-4">
        <span class="font-mono text-sm text-[color:var(--color-accent)] select-none" aria-hidden="true">$</span>
        <pre class="flex-1 overflow-x-auto text-[13px] font-mono py-2.5 [scrollbar-width:thin]"><code>{t.command}</code></pre>
        <button
          data-install-copy={t.id}
          class="shrink-0 inline-flex items-center gap-1.5 px-3 py-2 text-xs rounded-lg bg-white/5 hover:bg-white/10 text-[color:var(--color-text-muted)] hover:text-white transition"
        >
          <Icon name="copy" size={14} />
          <span data-copy-label>Copy</span>
        </button>
      </div>

      {t.next ? (
        <ol class="mt-5 grid gap-3 sm:grid-cols-3">
          {nextSteps.map((s, n) => (
            <li class="flex items-start gap-3">
              <span class="w-6 h-6 shrink-0 rounded-full grid place-items-center text-xs font-semibold bg-violet-500/15 text-violet-200 border border-violet-400/30">{n + 1}</span>
              <div class="min-w-0">
                <code class="cmd !text-[12.5px]">{s.cmd}</code>
                <div class="mt-1 text-[13px] text-[color:var(--color-text-muted)]">{s.body}</div>
              </div>
            </li>
          ))}
        </ol>
      ) : (
        <p class="mt-4 text-sm leading-relaxed text-[color:var(--color-text-muted)]" set:html={t.hint}></p>
      )}
    </div>
  ))}
</div>

<script>
  const tabs = document.querySelectorAll<HTMLButtonElement>('[data-install-tab]');
  const panels = document.querySelectorAll<HTMLElement>('[data-install-panel]');
  const copyButtons = document.querySelectorAll<HTMLButtonElement>('[data-install-copy]');

  tabs.forEach((btn) => {
    btn.addEventListener('click', () => {
      const id = btn.dataset.installTab;
      tabs.forEach((b) => b.setAttribute('aria-selected', b.dataset.installTab === id ? 'true' : 'false'));
      panels.forEach((p) => p.classList.toggle('hidden', p.dataset.installPanel !== id));
    });
  });

  copyButtons.forEach((btn) => {
    btn.addEventListener('click', async () => {
      const panel = document.querySelector<HTMLElement>(`[data-install-panel="${btn.dataset.installCopy}"]`);
      const label = btn.querySelector<HTMLElement>('[data-copy-label]');
      try {
        await navigator.clipboard.writeText(panel?.querySelector('code')?.textContent ?? '');
        if (label) {
          label.textContent = 'Copied';
          setTimeout(() => { label.textContent = 'Copy'; }, 1400);
        }
      } catch {
        /* clipboard unavailable */
      }
    });
  });
</script>
