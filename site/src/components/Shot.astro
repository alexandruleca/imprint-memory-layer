---
// A real dashboard capture in a window frame, labelled with the machine it
// was taken on.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  machine: string;
  caption?: string;
  class?: string;
}

const { src, alt, machine, caption, class: className = '' } = Astro.props;
---

<figure class={className}>
  <div class="rounded-2xl border border-[color:var(--color-border-strong)] bg-[color:var(--color-bg-elevated)] p-1.5 shadow-[0_30px_60px_-34px_rgba(0,0,0,0.28)]">
    <div class="flex items-center gap-2.5 px-2.5 py-1.5 text-[11px] font-mono text-[color:var(--color-text-dim)]">
      <span class="term-dots" aria-hidden="true"><i></i><i></i><i></i></span>
      <span>{machine} · Sync</span>
    </div>
    <Image
      src={src}
      alt={alt}
      widths={[480, 832, 1280, 1664]}
      sizes="(min-width: 1024px) 560px, 100vw"
      class="block w-full h-auto rounded-xl border border-[color:var(--color-border)]"
    />
  </div>
  {caption && <figcaption class="mt-3 text-sm text-[color:var(--color-text-dim)]">{caption}</figcaption>}
</figure>
