---
const ga4Id = import.meta.env.PUBLIC_GA4_ID;
---

{ga4Id && (
  <>
    {/* Loads Google Analytics only after the visitor accepts in its banner. */}
    <script is:inline defer src="/scripts/consent.js" data-ga4={ga4Id}></script>
    <script is:inline type="module" src="/scripts/events.js"></script>
  </>
)}
