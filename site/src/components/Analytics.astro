---
import { analyticsTags, volentiLoader, volentiSnippet } from '../lib/volenti.mjs';

const ga4Id = import.meta.env.PUBLIC_GA4_ID;
---

{ga4Id && (
  <>
    {/* Volenti asks for consent; Google Analytics runs only once the visitor allows Statistics (ADR 0231). */}
    <script is:inline set:html={volentiSnippet}></script>
    <script is:inline src={volentiLoader} async></script>
    {analyticsTags(ga4Id).map((attrs) => <script is:inline {...attrs}></script>)}
    <script is:inline type="module" src="/scripts/events.js"></script>
  </>
)}
