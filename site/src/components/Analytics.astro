---
const ga4Id = import.meta.env.PUBLIC_GA4_ID;
---

{ga4Id && (
  <>
    <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`}></script>
    {/* define:vars wraps this in a function: gtag must be set on window for
        the event script to reach it. */}
    <script is:inline define:vars={{ ga4Id }}>
      window.dataLayer = window.dataLayer || [];
      window.gtag = function gtag(){dataLayer.push(arguments);};
      gtag('js', new Date());
      gtag('config', ga4Id);
    </script>
    <script is:inline type="module" src="/scripts/events.js"></script>
  </>
)}
