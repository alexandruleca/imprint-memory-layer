---
import benchmarks from '../data/benchmarks.json';
import releases from '../data/releases.json';
import Icon from './Icon.astro';
import { signed } from '../lib/format';

const tokenPct = signed(benchmarks.overall?.tokenPct, '—');
const costPct = signed(benchmarks.overall?.costPct, '—');

const latestTag = releases.latestStable?.tag ?? '';

const oneLiners = [
  {
    id: 'unix',
    label: 'macOS / Linux',
    cmd: 'curl -fsSL https://raw.githubusercontent.com/alexandruleca/imprint-memory-layer/main/install.sh | bash',
  },
  {
    id: 'win',
    label: 'Windows',
    cmd: 'irm https://raw.githubusercontent.com/alexandruleca/imprint-memory-layer/main/install.ps1 | iex',
  },
];

const proof = [
  { value: tokenPct, label: 'tokens' },
  { value: costPct, label: 'cost' },
  { value: '7', label: 'agent hosts' },
  { value: '100%', label: 'local by default' },
];
---

<section class="relative overflow-hidden">
  <div class="absolute inset-0 dot-grid opacity-50 [mask-image:radial-gradient(ellipse_60%_55%_at_50%_0%,black,transparent)]"></div>
  <div class="relative wrap pt-16 pb-20 sm:pt-24 sm:pb-28 grid gap-14 lg:grid-cols-[1.05fr_1fr] lg:gap-12 items-center">
    <div class="stagger min-w-0">
      <a
        href={releases.latestStable?.htmlUrl ?? '/download'}
        class="chip !text-[13px] !py-1 hover:!border-[color:var(--color-accent)] transition"
      >
        <span class="w-1.5 h-1.5 rounded-full bg-[color:var(--color-success)]"></span>
        Open-source MCP memory layer
        {latestTag && <span class="font-mono text-[color:var(--color-text)]">{latestTag}</span>}
      </a>

      <h1 class="mt-7 text-[2.6rem] leading-[1.03] sm:text-6xl lg:text-[3.55rem] xl:text-[3.9rem] font-extrabold tracking-[-0.035em]">
        Remember once.<br />
        <span class="grad-text">Recall everywhere.</span>
      </h1>

      <p class="mt-6 text-lg text-[color:var(--color-text-muted)] max-w-xl leading-relaxed">
        Imprint gives your AI coding agents one persistent memory. The decisions, fixes and context they
        learn come back in every session and every tool, sync to your other machines, and can be handed
        to a teammate in one command. It all runs on your machine.
      </p>

      <div class="mt-8 flex flex-wrap gap-3">
        <a href="#install" class="btn btn-primary">
          Install {latestTag}
          <Icon name="arrowRight" size={16} />
        </a>
        <a href="#benefits" class="btn btn-ghost">See how it works</a>
      </div>

      <div class="mt-6 max-w-xl">
        <div class="flex items-center gap-1 mb-2" role="tablist" aria-label="Install command platform">
          {oneLiners.map((o, i) => (
            <button
              data-hero-oneliner-tab={o.id}
              class="px-2.5 py-1 text-xs font-medium rounded-md transition text-[color:var(--color-text-dim)] hover:text-white aria-selected:bg-white/5 aria-selected:text-white"
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
            >
              {o.label}
            </button>
          ))}
        </div>
        <div class="flex items-center gap-2 rounded-xl border border-[color:var(--color-border-strong)] bg-[color:var(--color-bg-elevated)] p-1.5 pl-3">
          <span class="font-mono text-sm text-[color:var(--color-accent)] select-none" aria-hidden="true">$</span>
          <pre class="flex-1 overflow-x-auto text-[13px] font-mono py-2 whitespace-nowrap [scrollbar-width:none]"><code data-hero-oneliner-cmd>{oneLiners[0].cmd}</code></pre>
          <button
            data-hero-oneliner-copy
            class="shrink-0 inline-flex items-center gap-1.5 px-3 py-2 text-xs rounded-lg bg-white/5 hover:bg-white/10 text-[color:var(--color-text-muted)] hover:text-white transition"
            aria-label="Copy install command"
          >
            <Icon name="copy" size={14} />
            <span data-copy-label>Copy</span>
          </button>
        </div>
      </div>

      <ul class="mt-10 grid grid-cols-2 sm:grid-cols-4 gap-x-6 gap-y-4 max-w-xl">
        {proof.map((p) => (
          <li class="flex flex-col">
            <span class="text-xl font-semibold tracking-tight text-[color:var(--color-text)]">{p.value}</span>
            <span class="text-xs text-[color:var(--color-text-dim)]">{p.label}</span>
          </li>
        ))}
      </ul>
    </div>

    <!-- Illustrative agent session: a decision recalled from memory synced from another machine. -->
    <div class="relative min-w-0">
      <div class="absolute -inset-10 bg-[radial-gradient(closest-side,rgba(139,92,246,0.22),transparent)] blur-2xl pointer-events-none" aria-hidden="true"></div>
      <figure class="relative term" aria-label="Example: an agent answers from Imprint memory">
        <div class="term-bar">
          <span class="term-dots"><i></i><i></i><i></i></span>
          <span class="font-mono">claude — ~/code/imprint</span>
        </div>
        <div class="term-body stagger !text-[12.5px] sm:!text-[13px]">
          <div>
            <span class="prompt">›</span>
            <span class="hl">Why does Imprint run Qdrant as a server instead of embedded?</span>
          </div>

          <div class="mt-4 flex items-baseline gap-2">
            <span class="text-[color:var(--color-cyan)]">●</span>
            <span><span class="hl">imprint</span> · search <span class="text-[color:var(--color-text-dim)]">"qdrant server vs embedded"</span></span>
          </div>
          <div class="mt-2 ml-4 rounded-lg border border-[color:var(--color-border-strong)] bg-white/[0.02] p-3 font-sans text-[13px] leading-relaxed">
            <div class="flex flex-wrap items-center gap-1.5 text-[11px] font-mono">
              <span class="px-1.5 py-0.5 rounded bg-violet-500/15 text-violet-200">decision</span>
              <span class="px-1.5 py-0.5 rounded bg-white/5 text-[color:var(--color-text-muted)]">imprint</span>
              <span class="px-1.5 py-0.5 rounded bg-white/5 text-[color:var(--color-text-muted)]">docs/architecture.md</span>
            </div>
            <p class="mt-2 text-[color:var(--color-text)]">
              Embedded Qdrant is single-writer: the MCP server, hooks and <code class="font-mono text-[12px]">imprint ingest</code>
              can't share its on-disk lock. Auto-spawn a local server on 127.0.0.1:6333 instead.
            </p>
            <div class="mt-2.5 flex flex-wrap items-center gap-x-4 gap-y-1 text-[11.5px] text-[color:var(--color-text-dim)]">
              <span class="inline-flex items-center gap-1.5"><Icon name="clock" size={13} /> stored 3 weeks ago</span>
              <span class="inline-flex items-center gap-1.5 text-[color:var(--color-cyan)]"><Icon name="sync" size={13} /> synced from workstation</span>
            </div>
          </div>

          <div class="mt-4 flex items-baseline gap-2">
            <span class="text-[color:var(--color-text)]">●</span>
            <span class="font-sans text-[13.5px] text-[color:var(--color-text)] leading-relaxed">
              Embedded mode locks the store to a single process. Imprint runs a local Qdrant server so your
              agent, its hooks and background ingests can all read and write at the same time.
            </span>
          </div>

          <div class="mt-4 ml-4 inline-flex items-center gap-2 text-[12px] ok">
            <Icon name="check" size={14} /> answered from memory · no files re-read
          </div>
        </div>
      </figure>
    </div>
  </div>

  <script define:vars={{ oneLiners }}>
    const ua = navigator.userAgent;
    const cmdEl = document.querySelector('[data-hero-oneliner-cmd]');
    const tabs = document.querySelectorAll('[data-hero-oneliner-tab]');
    const copyBtn = document.querySelector('[data-hero-oneliner-copy]');
    const copyLabel = copyBtn?.querySelector('[data-copy-label]');

    function activate(id) {
      const entry = oneLiners.find((o) => o.id === id);
      if (!entry || !cmdEl) return;
      cmdEl.textContent = entry.cmd;
      tabs.forEach((t) => {
        t.setAttribute('aria-selected', t.getAttribute('data-hero-oneliner-tab') === id ? 'true' : 'false');
      });
    }

    if (/Windows/i.test(ua)) activate('win');

    tabs.forEach((t) => {
      t.addEventListener('click', () => activate(t.getAttribute('data-hero-oneliner-tab')));
    });

    if (copyBtn && cmdEl && copyLabel) {
      copyBtn.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(cmdEl.textContent || '');
          copyLabel.textContent = 'Copied';
          setTimeout(() => { copyLabel.textContent = 'Copy'; }, 1300);
        } catch { /* clipboard unavailable */ }
      });
    }
  </script>
</section>
