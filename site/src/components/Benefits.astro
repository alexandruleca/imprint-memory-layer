---
import Icon from './Icon.astro';

const tools = ['Claude Code', 'Cursor', 'Copilot', 'Codex', 'Cline'];
const devices = [
  { icon: 'laptop', label: 'laptop' },
  { icon: 'monitor', label: 'desktop' },
  { icon: 'server', label: 'VPS' },
] as const;
const teammates = [
  { initial: 'A', tone: 'bg-neutral-900 text-white' },
  { initial: 'S', tone: 'bg-neutral-300 text-neutral-900' },
  { initial: 'M', tone: 'bg-neutral-100 text-neutral-800' },
];
---

<section id="benefits" class="section">
  <div class="wrap">
    <div class="max-w-2xl">
      <div class="eyebrow">Why Imprint</div>
      <h2 class="h2">Memory that isn't trapped in one chat window.</h2>
      <p class="lede">
        Built-in agent memory lives in one tool, on one machine, for one person. Every new session starts
        blank and your agent re-reads the same files. Imprint keeps what it learns and takes it with you.
      </p>
    </div>

    <div class="mt-14 grid gap-5 md:grid-cols-2">
      <!-- Sessions -->
      <article class="card p-6 sm:p-7">
        <div class="h-36 flex items-center">
          <ol class="relative w-full grid grid-cols-3 gap-3 text-center">
            <span class="absolute left-[16%] right-[16%] top-[13px] h-px bg-gradient-to-r from-accent-line via-accent-line to-accent-line" aria-hidden="true"></span>
            <li class="relative flex flex-col items-center gap-2.5">
              <span class="w-[27px] h-[27px] rounded-full bg-[color:var(--color-surface-2)] border border-[color:var(--color-border-strong)] grid place-items-center text-[10px] font-mono text-[color:var(--color-text-muted)]">Mon</span>
              <span class="chip !text-[11px]">+ decision</span>
            </li>
            <li class="relative flex flex-col items-center gap-2.5">
              <span class="w-[27px] h-[27px] rounded-full bg-[color:var(--color-surface-2)] border border-[color:var(--color-border-strong)] grid place-items-center text-[10px] font-mono text-[color:var(--color-text-muted)]">Tue</span>
              <span class="chip !text-[11px]">+ bug fix</span>
            </li>
            <li class="relative flex flex-col items-center gap-2.5">
              <span class="w-[27px] h-[27px] rounded-full bg-accent-soft border border-accent-line grid place-items-center text-accent"><Icon name="check" size={13} /></span>
              <span class="chip !text-[11px] !border-accent-line !text-accent">recalls both</span>
            </li>
          </ol>
        </div>
        <div class="flex items-center gap-2 text-sm font-semibold text-[color:var(--color-accent)]">
          <Icon name="history" size={16} /> Across sessions
        </div>
        <h3 class="mt-2 text-xl font-semibold tracking-tight">Tomorrow starts where today left off.</h3>
        <p class="mt-2 text-[15px] leading-relaxed text-[color:var(--color-text-muted)]">
          Hooks capture decisions as you work and save context before the window compacts. Your agent searches
          memory first, so it stops rediscovering the same answers.
        </p>
      </article>

      <!-- Tools -->
      <article class="card p-6 sm:p-7">
        <div class="h-36 flex flex-col items-center justify-center gap-3">
          <ul class="flex flex-wrap justify-center gap-1.5">
            {tools.map((t) => <li class="chip !text-[11px]">{t}</li>)}
          </ul>
          <span class="h-5 w-px bg-gradient-to-b from-accent-line to-transparent" aria-hidden="true"></span>
          <span class="inline-flex items-center gap-2 rounded-lg border border-accent-line bg-accent-soft px-3 py-1.5 text-xs font-medium text-accent">
            <img src="/logo.svg" alt="" width="16" height="16" /> one shared store
          </span>
        </div>
        <div class="flex items-center gap-2 text-sm font-semibold text-[color:var(--color-accent)]">
          <Icon name="layers" size={16} /> Across tools
        </div>
        <h3 class="mt-2 text-xl font-semibold tracking-tight">Switch editors without starting over.</h3>
        <p class="mt-2 text-[15px] leading-relaxed text-[color:var(--color-text-muted)]">
          Claude Code, Cursor, Copilot, Codex, Cline and other MCP hosts read and write the same memory. What
          one agent learns, the next one already knows.
        </p>
      </article>

      <!-- Machines -->
      <article class="card p-6 sm:p-7">
        <div class="h-36 flex items-center justify-center">
          <ul class="flex w-full max-w-sm items-center gap-1 sm:gap-2">
            {devices.map((d, i) => (
              <>
                {i > 0 && (
                  <li class="flex flex-1 min-w-6 items-center text-accent/80" aria-hidden="true">
                    <span class="flex-1 border-t border-dashed border-accent-line"></span>
                    <Icon name="sync" size={14} class="shrink-0" />
                    <span class="flex-1 border-t border-dashed border-accent-line"></span>
                  </li>
                )}
                <li class="flex flex-col items-center gap-2">
                  <span class="w-12 h-12 rounded-xl bg-[color:var(--color-surface-2)] border border-[color:var(--color-border-strong)] grid place-items-center text-[color:var(--color-text)]">
                    <Icon name={d.icon} size={22} />
                  </span>
                  <span class="text-[11px] font-mono whitespace-nowrap text-[color:var(--color-text-dim)]">{d.label}</span>
                </li>
              </>
            ))}
          </ul>
        </div>
        <div class="flex items-center gap-2 text-sm font-semibold text-[color:var(--color-accent)]">
          <Icon name="laptop" size={16} /> Across machines
        </div>
        <h3 class="mt-2 text-xl font-semibold tracking-tight">Your memory, on every machine you code on.</h3>
        <p class="mt-2 text-[15px] leading-relaxed text-[color:var(--color-text-muted)]">
          Pair a laptop, a desktop and a cloud box with a one-time share code. Memories and facts merge
          both ways, or one way, without duplicates, end-to-end encrypted. Projects are identified by their manifest, not their path, so they
          line up everywhere.
        </p>
      </article>

      <!-- Team -->
      <article class="card p-6 sm:p-7">
        <div class="h-40 sm:h-36 flex flex-col sm:flex-row items-center justify-center gap-1.5 sm:gap-3">
          <div class="flex -space-x-2.5 shrink-0">
            {teammates.map((t) => (
              <span class={`w-9 h-9 sm:w-11 sm:h-11 rounded-full ring-4 ring-[color:var(--color-surface)] grid place-items-center text-sm font-semibold ${t.tone}`}>{t.initial}</span>
            ))}
          </div>
          <span class="flex flex-col sm:flex-row sm:flex-1 sm:min-w-8 sm:max-w-24 items-center text-accent/80" aria-hidden="true">
            <span class="hidden sm:block flex-1 border-t border-dashed border-accent-line"></span>
            <Icon name="merge" size={16} class="shrink-0" />
            <span class="hidden sm:block flex-1 border-t border-dashed border-accent-line"></span>
          </span>
          <div class="shrink-0 whitespace-nowrap rounded-xl border border-[color:var(--color-border-strong)] bg-[color:var(--color-surface-2)] px-3 py-2.5 text-[11px] leading-5 font-mono text-[color:var(--color-text-muted)]">
            <div class="text-[color:var(--color-text)] font-sans font-semibold text-xs mb-0.5">workspace: team</div>
            decisions · fixes<br />docs · facts
          </div>
        </div>
        <div class="flex items-center gap-2 text-sm font-semibold text-[color:var(--color-accent)]">
          <Icon name="users" size={16} /> Across your team
        </div>
        <h3 class="mt-2 text-xl font-semibold tracking-tight">Onboard a teammate's agent in one sync.</h3>
        <p class="mt-2 text-[15px] leading-relaxed text-[color:var(--color-text-muted)]">
          Give a colleague what your agent has learned about a codebase: decisions, fixes and indexed docs.
          Copy just that project into a team workspace and send it, one way if you like. Everything else
          stays where it is.
        </p>
      </article>
    </div>
  </div>
</section>
