---
import Icon from './Icon.astro';

const links = [
  { href: '/#benefits', label: 'Why Imprint' },
  { href: '/#sync', label: 'Sync & share' },
  { href: '/installation', label: 'Docs' },
  { href: '/faq', label: 'FAQ' },
];
const repo = 'https://github.com/alexandruleca/imprint-memory-layer';
---

<header class="sticky top-0 z-40 backdrop-blur-md bg-[color:var(--color-bg)]/75 border-b border-[color:var(--color-border)]">
  <nav class="wrap h-16 flex items-center justify-between gap-4" aria-label="Main">
    <a href="/" class="flex items-center gap-2.5 font-semibold tracking-tight">
      <img src="/logo.svg" alt="" width="28" height="28" />
      <span class="text-[15px]">Imprint</span>
    </a>

    <div class="hidden md:flex items-center gap-1">
      {links.map((l) => (
        <a href={l.href} class="px-3 py-1.5 text-sm rounded-md text-[color:var(--color-text-muted)] hover:text-ink transition">
          {l.label}
        </a>
      ))}
    </div>

    <div class="flex items-center gap-2">
      <a
        href={repo}
        class="hidden sm:inline-flex items-center gap-2 px-3 py-1.5 text-sm rounded-md text-[color:var(--color-text-muted)] hover:text-ink transition"
      >
        <Icon name="github" size={16} />
        GitHub
      </a>
      <a href="/#install" class="btn btn-primary !py-2 !px-3.5 !text-sm">Install</a>

      <details class="md:hidden relative group">
        <summary class="list-none cursor-pointer p-2 rounded-md border border-[color:var(--color-border-strong)] text-[color:var(--color-text-muted)] [&::-webkit-details-marker]:hidden" aria-label="Menu">
          <Icon name="menu" size={18} class="group-open:hidden" />
          <Icon name="x" size={18} class="hidden group-open:block" />
        </summary>
        <div class="absolute right-0 mt-2 w-56 card p-2 shadow-2xl shadow-black/10">
          {links.map((l) => (
            <a href={l.href} class="block px-3 py-2.5 text-sm rounded-lg text-[color:var(--color-text-muted)] hover:text-ink hover:bg-fill">
              {l.label}
            </a>
          ))}
          <a href={repo} class="flex items-center gap-2 px-3 py-2.5 text-sm rounded-lg text-[color:var(--color-text-muted)] hover:text-ink hover:bg-fill">
            <Icon name="github" size={16} /> GitHub
          </a>
        </div>
      </details>
    </div>
  </nav>
</header>

<script>
  // Close the mobile menu after choosing an in-page anchor.
  document.querySelectorAll<HTMLDetailsElement>('header details').forEach((menu) => {
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) menu.open = false;
    });
  });
</script>
