---
import benchmarks from '../data/benchmarks.json';
const stats = benchmarks.overall;
const retrieval = benchmarks.retrieval;
const interval = (values: number[] | null) => values ? `${values[0].toFixed(1)}% to ${values[1].toFixed(1)}%` : 'not estimated';
---
<section class="mt-8 rounded-2xl p-6 bg-[color:var(--color-surface)] border border-[color:var(--color-border)]">
  <h2 class="text-lg font-semibold">Uncertainty and latency</h2>
  <p class="mt-2 text-sm text-[color:var(--color-text-muted)]">
    Token change, 95% interval: {interval(stats.tokenChangeCI95)}. Cost change: {interval(stats.costChangeCI95)}.
    End-to-end p50: {(stats.latency.off.p50Ms / 1000).toFixed(1)}s OFF → {(stats.latency.on.p50Ms / 1000).toFixed(1)}s ON;
    p95: {(stats.latency.off.p95Ms / 1000).toFixed(1)}s → {(stats.latency.on.p95Ms / 1000).toFixed(1)}s.
    Intervals resample paired tasks and repetitions, not individual tokens, and describe this fixed suite.
  </p>
  {retrieval && <>
    <h2 class="mt-6 text-lg font-semibold">Retrieval on the labeled public corpus</h2>
    <div class="overflow-x-auto mt-3">
      <table class="w-full text-sm text-left">
        <thead><tr><th class="py-2 pr-4">Mode</th><th class="pr-4">Recall@5</th><th class="pr-4">MRR@10</th><th class="pr-4">nDCG@10</th><th class="pr-4">Warm p50</th><th>Warm p95</th></tr></thead>
        <tbody>{Object.entries(retrieval.groups).map(([mode, group]) => <tr class="border-t border-[color:var(--color-border)] text-[color:var(--color-text-muted)]">
          <th class="py-2 pr-4 font-medium">{mode}</th><td class="pr-4">{group.at['5'].recall.toFixed(3)}</td>
          <td class="pr-4">{group.at['10'].reciprocal_rank.toFixed(3)}</td><td class="pr-4">{group.at['10'].ndcg.toFixed(3)}</td>
          <td class="pr-4">{group.p50Ms.toFixed(1)}ms</td><td>{group.p95Ms.toFixed(1)}ms</td>
        </tr>)}</tbody>
      </table>
    </div>
    <p class="mt-3 text-sm text-[color:var(--color-text-muted)]">
      {retrieval.metricUnit} {retrieval.groups.hybrid.queries} positive queries, plus explicit filter/workspace boundary cases;
      {retrieval.repetitions} timing repetitions per mode. Model load and first query: {(retrieval.coldModelLoadAndFirstQueryMs/1000).toFixed(1)}s.
      Fixed passages isolate retrieval from ingestion quality. Source relevance is not generated-answer correctness.
    </p>
  </>}
  <p class="mt-4 text-sm text-[color:var(--color-text-muted)]">
    <a href="/docs/benchmarks/" class="underline underline-offset-2">Methodology, corpus and limitations</a>
    {' · '}<a href={`https://github.com/alexandruleca/imprint-memory-layer/tree/main/benchmark/published/${benchmarks.runId}`} class="underline underline-offset-2">Trial evidence and manifest</a>
  </p>
</section>
