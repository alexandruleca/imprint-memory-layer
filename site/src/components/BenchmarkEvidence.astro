---
import benchmarks from '../data/benchmarks.json';
const stats = benchmarks.overall;
const retrieval = benchmarks.retrieval;
const measurement = benchmarks.measurement;
const interval = (values: number[] | null) => values ? `${values[0].toFixed(1)}% to ${values[1].toFixed(1)}%` : 'not estimated';
const points = (values: number[]) => `${(values[0]*100).toFixed(1)} to ${(values[1]*100).toFixed(1)} percentage points`;
---
<section class="mt-8 rounded-2xl p-6 bg-[color:var(--color-surface)] border border-[color:var(--color-border)]">
  <h2 class="text-lg font-semibold">Uncertainty and latency</h2>
  <p class="mt-2 text-sm text-[color:var(--color-text-muted)]">
    Token change, 95% interval: {interval(stats.tokenChangeCI95)}. Cost change: {interval(stats.costChangeCI95)}.
    End-to-end p50: {(stats.latency.off.p50Ms / 1000).toFixed(1)}s OFF → {(stats.latency.on.p50Ms / 1000).toFixed(1)}s ON;
    p95: {(stats.latency.off.p95Ms / 1000).toFixed(1)}s → {(stats.latency.on.p95Ms / 1000).toFixed(1)}s.
    Intervals resample paired tasks and repetitions, not individual tokens, and describe this fixed suite.
    {stats.costChangeCI95 && stats.costChangeCI95[0] <= 0 && stats.costChangeCI95[1] >= 0 && 'The cost interval includes no change, so the point estimate does not establish a clear saving.'}
  </p>
  {benchmarks.previous && <>
    <h2 class="mt-6 text-lg font-semibold">Before and after compact MCP responses</h2>
    <div class="overflow-x-auto mt-3">
      <table class="w-full text-sm text-left">
        <thead><tr><th class="py-2 pr-4">Run</th><th class="pr-4">Trials</th><th class="pr-4">Token change ON vs OFF</th><th>Estimated cost change ON vs OFF</th></tr></thead>
        <tbody>{[["Previous response policy", benchmarks.previous], ["Compact response policy", benchmarks]].map(([label, run]: any) => <tr class="border-t border-[color:var(--color-border)] text-[color:var(--color-text-muted)]">
          <th class="py-2 pr-4 font-medium">{label}</th><td class="pr-4">{run.runCount}</td>
          <td class="pr-4">{run.overall.tokenPct} ({interval(run.overall.tokenChangeCI95)})</td>
          <td>{run.overall.costPct} ({interval(run.overall.costChangeCI95)})</td>
        </tr>)}</tbody>
      </table>
    </div>
    <p class="mt-3 text-sm text-[color:var(--color-text-muted)]">
      Same frozen evidence, task suite, model and repeat count. These runs were collected sequentially,
      with provider-managed caches and service variation. Each row compares matched ON/OFF trials within
      its run; this table is descriptive and does not isolate a causal version effect or establish answer quality.
      <a href={`https://github.com/alexandruleca/imprint-memory-layer/tree/main/benchmark/published/${benchmarks.previous.runId}`} class="underline">Previous trial evidence</a>.
    </p>
  </>}
  {retrieval && <>
    <h2 class="mt-6 text-lg font-semibold">Retrieval on the labeled public corpus</h2>
    <div class="overflow-x-auto mt-3">
      <table class="w-full text-sm text-left">
        <thead><tr><th class="py-2 pr-4">Mode</th><th class="pr-4">Recall@5</th><th class="pr-4">MRR@10</th><th class="pr-4">nDCG@10</th><th class="pr-4">Warm p50</th><th>Warm p95</th></tr></thead>
        <tbody>{Object.entries(retrieval.groups).map(([mode, group]) => <tr class="border-t border-[color:var(--color-border)] text-[color:var(--color-text-muted)]">
          <th class="py-2 pr-4 font-medium">{mode}</th><td class="pr-4">{group.at['5'].recall.toFixed(3)}</td>
          <td class="pr-4">{group.at['10'].reciprocal_rank.toFixed(3)}</td><td class="pr-4">{group.at['10'].ndcg.toFixed(3)}</td>
          <td class="pr-4">{group.p50Ms.toFixed(1)}ms</td><td>{group.p95Ms.toFixed(1)}ms</td>
        </tr>)}</tbody>
      </table>
    </div>
    <p class="mt-3 text-sm text-[color:var(--color-text-muted)]">
      {retrieval.metricUnit} {retrieval.groups.hybrid.queries} positive queries, plus explicit filter/workspace boundary cases;
      {retrieval.repetitions} timing repetitions per mode. Model load and first query: {(retrieval.coldModelLoadAndFirstQueryMs/1000).toFixed(1)}s.
      Fixed passages isolate retrieval from ingestion quality. These metrics score ranked chunks before MCP response budgeting; they do not prove which evidence an agent read or generated-answer correctness.
    </p>
    <p class="mt-3 text-sm text-[color:var(--color-text-muted)]">
      Hybrid − semantic Recall@5: {(retrieval.comparison.recallAt5.hybridMinusSemantic*100).toFixed(1)} percentage points;
      paired query-family bootstrap interval: {points(retrieval.comparison.recallAt5.ci95)}.
      {retrieval.comparison.recallAt5.ci95[0] <= 0 && retrieval.comparison.recallAt5.ci95[1] >= 0 && 'The interval includes no difference; this does not establish a clear retrieval winner.'}
      Boundary checks: {retrieval.groups.hybrid.boundaryPasses + retrieval.groups.semantic.boundaryPasses}/{retrieval.groups.hybrid.boundaryChecks + retrieval.groups.semantic.boundaryChecks} passed.
    </p>
    <p class="mt-3 text-sm text-[color:var(--color-text-muted)]">
      {measurement.index.model}, {measurement.index.dimensions} dimensions, {measurement.index.sequenceLength}-token cap,
      {measurement.index.threads} ONNX threads. Host: {measurement.hardware.cpuModel ?? measurement.hardware.architecture}.
      Timings come from a shared {measurement.hardware.os} host and are not platform-wide performance guarantees.
    </p>
  </>}
  <p class="mt-4 text-sm text-[color:var(--color-text-muted)]">
    Runtime: <code>{measurement.runtimeRevision.slice(0, 12)}</code>;
    frozen evidence: <code>{measurement.corpusRevision.slice(0, 12)}</code>.
    {' '}
    <a href="/docs/benchmarks/" class="underline underline-offset-2">Methodology, corpus and limitations</a>
    {' · '}<a href={`https://github.com/alexandruleca/imprint-memory-layer/tree/main/benchmark/published/${benchmarks.runId}`} class="underline underline-offset-2">Trial evidence and manifest</a>
  </p>
</section>
