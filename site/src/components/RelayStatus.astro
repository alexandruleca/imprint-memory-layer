---
// Live status of the public relay, read from its /health in the visitor's
// browser and refreshed while the page is visible.
interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;

const relay = 'https://sync.alexandruleca.com';
const host = new URL(relay).host;
---

<div class={`card overflow-hidden ${className}`} data-relay-status data-health={`${relay}/health`} data-state="checking">
  <div class="grid gap-px bg-[color:var(--color-border)] lg:grid-cols-[1.1fr_2fr]">
    <div class="bg-[color:var(--color-surface)] p-6 flex flex-col justify-between gap-5">
      <div class="flex items-start gap-3.5">
        <span class="relay-dot mt-1.5" aria-hidden="true"></span>
        <div class="min-w-0">
          <p class="font-semibold" data-relay-headline role="status">Checking the public relay…</p>
          <p class="mt-1 text-sm leading-relaxed text-[color:var(--color-text-muted)]" data-relay-detail>
            Sync codes made without <code class="cmd">--relay</code> meet here.
          </p>
        </div>
      </div>
      <a
        href={relay}
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-1.5 self-start font-mono text-[13px] text-[color:var(--color-text-muted)] hover:text-ink underline underline-offset-4 decoration-[color:var(--color-border-strong)]"
      >
        {host} <span aria-hidden="true">↗</span><span class="sr-only"> (opens in a new tab)</span>
      </a>
    </div>

    <dl class="grid grid-cols-1 gap-px bg-[color:var(--color-border)] sm:grid-cols-3">
      <div class="bg-[color:var(--color-surface)] p-6">
        <dt class="text-xs uppercase tracking-widest text-[color:var(--color-text-dim)]">Sessions relayed</dt>
        <dd class="relay-figure" data-relay-sessions>—</dd>
        <dd class="mt-1 text-xs text-[color:var(--color-text-dim)]" data-relay-since>machines paired through it</dd>
      </div>
      <div class="bg-[color:var(--color-surface)] p-6">
        <dt class="text-xs uppercase tracking-widest text-[color:var(--color-text-dim)]">Rooms open now</dt>
        <dd class="relay-figure" data-relay-rooms>—</dd>
        <dd class="mt-1 text-xs text-[color:var(--color-text-dim)]">sessions waiting or running</dd>
      </div>
      <div class="bg-[color:var(--color-surface)] p-6">
        <dt class="text-xs uppercase tracking-widest text-[color:var(--color-text-dim)]">Release</dt>
        <dd class="relay-figure font-mono !text-2xl sm:!text-[1.65rem]" data-relay-version>—</dd>
        <dd class="mt-1 text-xs text-[color:var(--color-text-dim)]">follows stable releases</dd>
      </div>
    </dl>
  </div>
</div>

<style>
  .relay-figure {
    margin-top: 0.5rem;
    font-size: 1.875rem;
    line-height: 1.15;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--color-ink);
    font-variant-numeric: tabular-nums;
  }
  .relay-dot {
    position: relative;
    flex-shrink: 0;
    width: 0.625rem;
    height: 0.625rem;
    border-radius: 999px;
    background: var(--color-border-strong);
  }
  [data-state='online'] .relay-dot {
    background: var(--color-success);
  }
  [data-state='unreachable'] .relay-dot {
    background: var(--color-warning);
  }
  @media (prefers-reduced-motion: no-preference) {
    [data-state='online'] .relay-dot::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      background: var(--color-success);
      animation: relay-pulse 2.4s ease-out infinite;
    }
  }
  @keyframes relay-pulse {
    0% { transform: scale(1); opacity: 0.55; }
    70%, 100% { transform: scale(2.6); opacity: 0; }
  }
</style>

<script>
  const REFRESH_MS = 30_000;
  const count = new Intl.NumberFormat('en-US');
  const day = new Intl.DateTimeFormat('en-US', { month: 'short', day: 'numeric' });

  function watch(card: HTMLElement) {
    // Only changed text is written, so the status line isn't re-announced.
    const set = (name: string, text: string) => {
      const el = card.querySelector<HTMLElement>(`[data-relay-${name}]`);
      if (el && el.textContent !== text) el.textContent = text;
    };

    async function refresh() {
      try {
        const res = await fetch(card.dataset.health!, { cache: 'no-store', signal: AbortSignal.timeout(8000) });
        const health = await res.json();
        if (!res.ok || health.status !== 'ok') throw new Error(`relay answered ${res.status}`);
        card.dataset.state = 'online';
        set('headline', 'Public relay online');
        set('detail', 'Forwarding end-to-end encrypted sync sessions it cannot read.');
        set('rooms', count.format(health.rooms));
        set('version', health.version);
        if (typeof health.sessions === 'number') {
          set('sessions', count.format(health.sessions));
          set('since', `since its restart on ${day.format(new Date(health.since))}`);
        }
      } catch {
        card.dataset.state = 'unreachable';
        set('headline', 'Couldn’t reach the public relay');
        set('detail', 'This browser got no answer just now. Open it directly to check.');
      }
    }

    refresh();
    setInterval(() => { if (!document.hidden) refresh(); }, REFRESH_MS);
    document.addEventListener('visibilitychange', () => { if (!document.hidden) refresh(); });
  }

  const card = document.querySelector<HTMLElement>('[data-relay-status]');
  if (card) watch(card);
</script>
