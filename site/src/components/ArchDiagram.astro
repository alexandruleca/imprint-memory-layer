---
import Icon from './Icon.astro';

const stores = [
  { icon: 'database', title: 'Qdrant', detail: 'vectors · local daemon on 127.0.0.1:6333' },
  { icon: 'clock', title: 'Imprint graph', detail: 'temporal facts · SQLite per workspace' },
  { icon: 'cpu', title: 'Embeddings', detail: 'Qwen3 via ONNX Runtime · CPU or GPU' },
] as const;

const optIn = [
  { icon: 'sync', title: 'Sync relay', detail: 'only while you run imprint sync; end-to-end encrypted, sees ciphertext only' },
  { icon: 'cloud', title: 'Cloud LLM tagging', detail: 'off by default; Anthropic, OpenAI, Gemini, or local Ollama / vLLM' },
] as const;
---

<section id="architecture" class="section border-t border-[color:var(--color-border)]">
  <div class="wrap">
    <div class="max-w-2xl">
      <div class="eyebrow"><Icon name="shield" size={14} /> How it works</div>
      <h2 class="h2">Private by default. Shared only when you say so.</h2>
      <p class="lede">
        Your agent talks MCP to a local Imprint server. Storage, embeddings and tagging all run on your
        machine, with no paid API calls. Data leaves only when you sync, encrypted end to end, or switch on a
        cloud tagger.
      </p>
    </div>

    <div class="mt-12 grid gap-4 lg:grid-cols-[1fr_17rem]">
      <div class="relative rounded-2xl border border-dashed border-accent-line p-4 pt-10 sm:p-8 sm:pt-12">
        <span class="absolute top-4 left-4 sm:left-8 text-[11px] font-semibold tracking-[0.16em] text-accent">YOUR MACHINE</span>

        <div class="card !bg-[color:var(--color-surface-2)] p-4 sm:p-5 flex items-center gap-4">
          <span class="icon-tile"><Icon name="terminal" size={19} /></span>
          <div>
            <div class="font-semibold">Your AI coding agent</div>
            <div class="text-sm text-[color:var(--color-text-muted)]">Claude Code · Cursor · Copilot · Codex · Cline · …</div>
          </div>
        </div>

        <div class="flex items-center gap-3 py-2 pl-9" aria-hidden="true">
          <span class="h-8 w-px bg-accent-line"></span>
          <span class="font-mono text-[11px] text-accent">MCP · stdio</span>
        </div>

        <div class="card !border-accent-line !bg-accent-soft p-4 sm:p-5 flex items-center gap-4">
          <span class="icon-tile"><img src="/logo.svg" alt="" width="22" height="22" /></span>
          <div>
            <div class="font-semibold">Imprint MCP server</div>
            <div class="text-sm text-[color:var(--color-text-muted)]">17 tools · hooks · chunker · tagger</div>
          </div>
        </div>

        <div class="sm:hidden h-6 ml-9 w-px bg-accent-line" aria-hidden="true"></div>
        <div class="hidden sm:grid grid-cols-3 px-[16%] h-6" aria-hidden="true">
          <span class="justify-self-start w-px h-full bg-accent-line"></span>
          <span class="justify-self-center w-px h-full bg-accent-line"></span>
          <span class="justify-self-end w-px h-full bg-accent-line"></span>
        </div>

        <ul class="grid gap-3 sm:grid-cols-3">
          {stores.map((s) => (
            <li class="card !bg-[color:var(--color-surface-2)] p-4">
              <Icon name={s.icon} size={18} class="text-ink" />
              <div class="mt-2.5 font-semibold text-[15px]">{s.title}</div>
              <div class="mt-0.5 text-[13px] leading-snug text-[color:var(--color-text-muted)]">{s.detail}</div>
            </li>
          ))}
        </ul>
      </div>

      <div class="rounded-2xl border border-dashed border-[color:var(--color-border-strong)] p-4 pt-10 sm:p-6 sm:pt-12 relative">
        <span class="absolute top-4 left-4 sm:left-6 text-[11px] font-semibold tracking-[0.16em] text-[color:var(--color-text-dim)]">ONLY WHEN YOU CHOOSE</span>
        <ul class="grid gap-3">
          {optIn.map((o) => (
            <li class="rounded-xl border border-[color:var(--color-border)] p-4">
              <Icon name={o.icon} size={18} class="text-[color:var(--color-text-muted)]" />
              <div class="mt-2.5 font-semibold text-[15px]">{o.title}</div>
              <div class="mt-0.5 text-[13px] leading-snug text-[color:var(--color-text-muted)]">{o.detail}</div>
            </li>
          ))}
        </ul>
      </div>
    </div>

    <p class="mt-6 text-sm text-[color:var(--color-text-dim)] max-w-3xl">
      Uninstalling is symmetric: <code class="cmd">imprint disable</code> removes every host entry it wrote
      and keeps your data, so <code class="cmd">imprint enable</code> brings it all back.
      <a href="/architecture" class="underline underline-offset-2 hover:text-ink">Architecture docs</a>.
    </p>
  </div>
</section>
