---
import Landing from '../layouts/Landing.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import benchmarks from '../data/benchmarks.json';
import BenchmarkEvidence from '../components/BenchmarkEvidence.astro';

const title = 'Benchmarks — Imprint MCP Memory Layer';
const description =
  'Measured Imprint retrieval and Claude Code task usage on a frozen public corpus, with trial evidence, failures and statistical uncertainty.';

const overall = benchmarks.overall;
const env = benchmarks.env;
const categories = benchmarks.categories ?? [];

function pctClass(s?: string) {
  if (!s) return '';
  const v = parseFloat(s.replace(/^\$/, ''));
  if (v < 0) return 'text-[color:var(--color-success)]';
  if (v > 0) return 'text-[color:var(--color-warning)]';
  return '';
}

function qualityClass(s?: string) {
  if (!s) return '';
  const v = parseFloat(s);
  if (v > 0) return 'text-[color:var(--color-success)]';
  if (v < 0) return 'text-[color:var(--color-warning)]';
  return '';
}

function fmtTokens(n?: number) {
  if (typeof n !== 'number') return '—';
  return n.toLocaleString('en-US');
}
---

<Landing title={title} description={description} pathname="/benchmarks/">
  <Nav />
  <main class="max-w-6xl mx-auto px-6 py-16">
    <a href="/" class="text-sm text-[color:var(--color-text-muted)] hover:text-ink">← Back to overview</a>
    <h1 class="mt-4 text-4xl sm:text-5xl font-extrabold tracking-tight">Imprint benchmark evidence</h1>
    <p class="mt-4 max-w-3xl text-[color:var(--color-text-muted)]">
      Measured {benchmarks.generatedAt.slice(0, 10)} with Claude Code CLI: {benchmarks.runCount} trials,
      {benchmarks.validPairs} complete successful pairs and {benchmarks.failedRuns} failed trials.
      Both modes receive identical public source files and synthetic historical evidence. ON adds read-only
      Imprint tools and memory-first guidance with file fallback. Overview totals sum paired trials;
      task tables report medians across {benchmarks.repetitions} repetitions. Sanitized evidence is at
      <code class="font-mono text-sm">benchmark/published/{benchmarks.runId}/</code>.
    </p>

    {overall && (
      <section class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        <div class="rounded-2xl p-6 bg-[color:var(--color-surface)] border border-[color:var(--color-border)]">
          <div class="text-xs uppercase tracking-widest text-[color:var(--color-text-muted)]">Tokens</div>
          <div class={`mt-2 text-4xl font-bold font-mono ${pctClass(overall.tokenPct)}`}>{overall.tokenPct}</div>
          <div class="mt-1 text-sm text-[color:var(--color-text-muted)] font-mono">
            {fmtTokens(overall.tokensOff)} → {fmtTokens(overall.tokensOn)}
          </div>
        </div>
        <div class="rounded-2xl p-6 bg-[color:var(--color-surface)] border border-[color:var(--color-border)]">
          <div class="text-xs uppercase tracking-widest text-[color:var(--color-text-muted)]">Cost</div>
          <div class={`mt-2 text-4xl font-bold font-mono ${pctClass(overall.costPct)}`}>{overall.costPct}</div>
          <div class="mt-1 text-sm text-[color:var(--color-text-muted)] font-mono">
            ${overall.costOff?.toFixed(4)} → ${overall.costOn?.toFixed(4)}
          </div>
        </div>
        {overall.qualityPct && (
          <div class="rounded-2xl p-6 bg-[color:var(--color-surface)] border border-[color:var(--color-border)]">
            <div class="text-xs uppercase tracking-widest text-[color:var(--color-text-muted)]">Quality</div>
            <div class="mt-2 text-4xl font-bold font-mono text-[color:var(--color-success)]">{overall.qualityPct}</div>
            <div class="mt-1 text-sm text-[color:var(--color-text-muted)] font-mono">
              weighted avg · LLM-as-judge<br />
              vs OFF baseline (0% = tie)
            </div>
          </div>
        )}
        <div class="rounded-2xl p-6 bg-[color:var(--color-surface)] border border-[color:var(--color-border)]">
          <div class="text-xs uppercase tracking-widest text-[color:var(--color-text-muted)]">Environment</div>
          <div class="mt-2 text-sm text-[color:var(--color-text)] font-mono leading-relaxed">
            {env && (
              <>
                OS: {env.os}<br />
                Python: {env.python}<br />
                Model: {env.model}<br />
                Imprint: {env.imprint}<br />
                Memories: {env.memories.toLocaleString('en-US')}
              </>
            )}
          </div>
        </div>
      </section>
    )}

    <section class="mt-8 rounded-2xl p-6 bg-[color:var(--color-surface)] border border-[color:var(--color-border)]">
      <h3 class="text-lg font-semibold">Reading the numbers</h3>
      <p class="mt-2 text-sm text-[color:var(--color-text-muted)] leading-relaxed">
        {benchmarks.methodology.overview} {benchmarks.methodology.cost} {benchmarks.methodology.cache}
        No answer-quality uplift is claimed. Lexical reference checks do not establish factual correctness,
        and follow-up turns were not measured. Protocol v2 uses a different corpus and model from the old
        Imprint 0.5.1 experiment, so this is a fresh baseline rather than a controlled version comparison.
      </p>
    </section>

    <BenchmarkEvidence />

    <section class="mt-16 space-y-10">
      {categories.map((cat: any) => (
        <div class="rounded-2xl bg-[color:var(--color-surface)] border border-[color:var(--color-border)] overflow-hidden">
          <div class="px-6 py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-2 border-b border-[color:var(--color-border)]">
            <h2 class="text-xl font-bold">{cat.label}</h2>
            <div class="flex flex-wrap items-center gap-4 text-sm font-mono">
              <span class={pctClass(cat.avgTokens)}>tokens {cat.avgTokens}</span>
              <span class={pctClass(cat.avgCost)}>cost {cat.avgCost}</span>
              {cat.quality && (
                <span class={qualityClass(cat.quality)}>quality {cat.quality}</span>
              )}
            </div>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-sm">
              <thead class="text-left text-xs uppercase tracking-wide text-[color:var(--color-text-muted)]">
                <tr>
                  <th class="px-6 py-3 font-medium">Prompt</th>
                  <th class="px-4 py-3 font-medium text-right">OFF tokens</th>
                  <th class="px-4 py-3 font-medium text-right">ON tokens</th>
                  <th class="px-4 py-3 font-medium text-right">Δ %</th>
                  <th class="px-4 py-3 font-medium text-right">OFF cost</th>
                  <th class="px-4 py-3 font-medium text-right">ON cost</th>
                  <th class="px-4 py-3 font-medium text-right">Δ $</th>
                </tr>
              </thead>
              <tbody class="font-mono">
                {(cat.rows ?? []).map((r: any) => (
                  <tr class="border-t border-[color:var(--color-border)]/60">
                    <td class="px-6 py-3 font-sans font-medium">{r.prompt}</td>
                    <td class="px-4 py-3 text-right text-[color:var(--color-text-muted)]">{fmtTokens(r.offTokens)}</td>
                    <td class="px-4 py-3 text-right">{fmtTokens(r.onTokens)}</td>
                    <td class={`px-4 py-3 text-right ${pctClass(r.pct)}`}>{r.pct}</td>
                    <td class="px-4 py-3 text-right text-[color:var(--color-text-muted)]">{r.offCost}</td>
                    <td class="px-4 py-3 text-right">{r.onCost}</td>
                    <td class={`px-4 py-3 text-right ${pctClass(r.costDelta)}`}>{r.costDelta}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
          {cat.note && (
            <div class="px-6 py-4 border-t border-[color:var(--color-border)]/60 bg-[color:var(--color-bg-elevated)]/40">
              <div class="flex items-start gap-3">
                <span class="mt-0.5 inline-flex h-6 px-2 items-center rounded-full text-[10px] uppercase tracking-widest font-semibold bg-[color:var(--color-accent)]/15 text-[color:var(--color-accent)] border border-[color:var(--color-accent)]/30">Why</span>
                <div class="text-sm leading-relaxed">
                  <div class="font-semibold text-[color:var(--color-text)]">{cat.note.headline}</div>
                  <p class="mt-1 text-[color:var(--color-text-muted)]">{cat.note.body}</p>
                </div>
              </div>
            </div>
          )}
        </div>
      ))}
    </section>

    <section class="mt-16 grid grid-cols-1 gap-6 lg:grid-cols-2">
      <div class="min-w-0 rounded-2xl p-6 bg-[color:var(--color-surface)] border border-[color:var(--color-border)]">
        <h3 class="text-lg font-semibold">How to reproduce</h3>
        <pre class="mt-3 overflow-x-auto text-xs font-mono bg-[color:var(--color-bg)] p-4 rounded-lg border border-[color:var(--color-border)]"><code># Full suite: {benchmarks.promptCount} prompts × {benchmarks.repetitions} repeats × 2 modes
bash benchmark/run.sh

# Subset (one prompt per category)
bash benchmark/run.sh --subset

# Filter by category or prompt
bash benchmark/run.sh --category debug
bash benchmark/run.sh --prompt info-1

# Summarize existing results
python3 benchmark/summarize.py benchmark/results/RUN_ID --publish</code></pre>
      </div>
      <div class="min-w-0 rounded-2xl p-6 bg-[color:var(--color-surface)] border border-[color:var(--color-border)]">
        <h3 class="text-lg font-semibold">What we're measuring</h3>
        <ul class="mt-3 space-y-2 text-sm text-[color:var(--color-text-muted)] list-disc pl-5">
          <li>Total tokens: input + output + cache_read + cache_create across every reported model. Subagents are disabled in this controlled suite.</li>
          <li>Cost: Claude Code's reported total list-price estimate. Cache classes are retained separately; this is not a subscription invoice.</li>
          <li>Latency: end-to-end client wall time, including MCP startup for ON; serial warm retrieval timings are reported separately.</li>
          <li>Quality: labeled source retrieval metrics and diagnostic reference checks. A biased LLM judge is no longer used.</li>
        </ul>
      </div>
    </section>
  </main>
  <Footer />
</Landing>
