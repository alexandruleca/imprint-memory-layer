---
import Landing from '../layouts/Landing.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';
import releases from '../data/releases.json';
import {chromeWebStoreUrl, latestChromeExtension, latestFirefoxExtension} from '../lib/chrome-extension.mjs';

const extension = latestChromeExtension(releases);
const firefox = latestFirefoxExtension(releases);
const title = 'Browser extension — Save pages, files and screenshots to Imprint';
const description = 'Save page text, a selection, a PDF or attachment, a Google Doc or Sheet, or the text in a screenshot to your local Imprint memory from Chrome or Firefox. Preview what you save; it goes only to Imprint on your computer.';
const comingSoon = [
  {icon: 'message', title: 'Gmail', body: 'Bring useful emails and conversations into your memory.'},
  {icon: 'sync', title: 'Background capture', body: 'Choose sites to capture automatically and connect mailbox sync.'},
  {icon: 'history', title: 'Offline retries', body: 'Keep a capture ready until your local Imprint is available again.'},
] as const;
---

<Landing title={title} description={description} pathname="/chrome-extension/">
  <Nav />
  <main>
    <section class="border-b border-[color:var(--color-border)] overflow-hidden">
      <div class="wrap py-16 sm:py-24 grid gap-14 lg:grid-cols-2 lg:items-center">
        <div>
          <div class="eyebrow"><Icon name="globe" size={14} /> Chrome &amp; Firefox extension <span class="preview-badge">Preview</span></div>
          <h1 class="mt-5 text-5xl sm:text-6xl font-extrabold tracking-tight leading-[1.04] text-balance">Keep what<br />you find.</h1>
          <p class="lede max-w-lg">A useful page. A passage, a PDF, a Google Doc. Save it to your local Imprint memory, right from your browser.</p>
          <div class="mt-8 flex flex-wrap gap-3">
            <a href={chromeWebStoreUrl} class="btn btn-primary"><Icon name="globe" size={17} /> Add to Chrome</a>
            {firefox && <a href={firefox.asset.url} class="btn btn-ghost"><Icon name="download" size={17} /> Firefox add-on</a>}
            <a href="#install" class="btn btn-ghost">How to install <Icon name="arrowRight" size={16} /></a>
          </div>
          <p class="mt-4 text-xs text-[color:var(--color-text-dim)]">Chrome Web Store · updates itself · Pages, files, screenshots &amp; meetings{extension && <> · or the <a href={extension.asset.url} class="underline underline-offset-2" data-extension-download>{extension.release.tag} ZIP</a> to load by hand</>}</p>
          <div class="mt-7 rounded-xl border border-[color:var(--color-border)] bg-[color:var(--color-surface)] p-4 max-w-lg text-sm">
            <strong class="font-semibold">Keep local Imprint running.</strong>
            <p class="mt-1 text-[color:var(--color-text-muted)]">The extension saves to the Imprint app on your computer. Keep the app up to date as the extension updates. <a href="/download/" class="underline underline-offset-2">Download Imprint →</a></p>
          </div>
        </div>

        <figure class="capture-illustration" aria-label="Illustration of saving a page to local Imprint">
          <div class="browser-frame card">
            <div class="browser-bar"><span class="window-dots"><i></i><i></i><i></i></span><span class="browser-address"><Icon name="lock" size={12} /> docs.example.com / architecture</span><Icon name="globe" size={17} /></div>
            <div class="article-sample"><span class="sample-label">FIELD NOTES / 04</span><h2>Good ideas deserve<br />a second visit.</h2><p>The most useful context is often something you have already read.</p><p><mark>Capture the details while they are in front of you.</mark> Keep the source, choose a project, and find them again when they matter.</p><div class="sample-lines" aria-hidden="true"><i></i><i></i><i></i></div></div>
          </div>
          <div class="capture-panel island">
            <div class="flex items-center justify-between gap-3"><img src="/logo-lockup-dark.svg" width="88" height="21" alt="Imprint" /><span class="text-xs text-[color:var(--color-text-dim)]">capture · preview</span></div>
            <div class="capture-connected"><span></span> Connected to local Imprint</div>
            <div class="text-xs text-[color:var(--color-text-muted)] mt-5">Workspace</div><div class="mock-field mt-1">Personal</div>
            <div class="text-xs text-[color:var(--color-text-muted)] mt-4">Project</div><div class="mock-field mt-1">Research</div>
            <div class="text-xs text-[color:var(--color-text-muted)] mt-4">Content to save</div><div class="mock-field mt-1 leading-relaxed">Capture the details while they are in front of you.</div>
            <div class="mock-save"><Icon name="check" size={15} /> Save to Imprint</div>
            <p class="mt-3 text-[11px] text-[color:var(--color-text-dim)]">You choose what becomes memory.</p>
          </div>
          <figcaption class="text-xs text-[color:var(--color-text-dim)] mt-4">An illustration of the page-to-memory workflow.</figcaption>
        </figure>
      </div>
    </section>

    <section class="section">
      <div class="wrap grid gap-5 md:grid-cols-3">
        <article class="card p-7"><Icon name="file" size={22} /><h2 class="mt-5 text-lg font-semibold">Save a page or a passage</h2><p class="mt-2 text-sm text-[color:var(--color-text-muted)]">Save signed-in page text, Google Docs and Sheets, PDFs, attachments, and OCR from images, the visible tab or the whole page.</p></article>
        <article class="card p-7"><Icon name="check" size={22} /><h2 class="mt-5 text-lg font-semibold">Review before you save</h2><p class="mt-2 text-sm text-[color:var(--color-text-muted)]">The popup offers what suits the tab first. Check the preview, edit the title, and choose a local workspace and project.</p></article>
        <article class="card p-7"><Icon name="server" size={22} /><h2 class="mt-5 text-lg font-semibold">Keep it in your Imprint</h2><p class="mt-2 text-sm text-[color:var(--color-text-muted)]">Search the chosen workspace or open the local recorder with your Meet or Teams title.</p></article>
      </div>
    </section>

    <section id="install" class="section border-y border-[color:var(--color-border)] bg-[color:var(--color-surface)]">
      <div class="wrap grid gap-12 lg:grid-cols-[.8fr_1.2fr]">
        <div><div class="eyebrow">Installation</div><h2 class="mt-3 text-3xl sm:text-4xl font-bold tracking-tight">One click.<br />Your Chrome toolbar.</h2><p class="mt-5 text-[color:var(--color-text-muted)]">Install Imprint Capture from the Chrome Web Store and Chrome keeps it up to date. Each release also carries a ZIP to load by hand.</p><a href="/browser-extension/" class="inline-flex items-center gap-2 mt-6 text-sm font-semibold underline underline-offset-4">Full setup &amp; troubleshooting <Icon name="arrowRight" size={15} /></a></div>
        <ol class="install-steps">
          <li><span class="step-number">01</span><div><h3>Add it to Chrome</h3><p>Open <a href={chromeWebStoreUrl} class="underline underline-offset-2">Imprint Capture in the Chrome Web Store</a> and click <strong>Add to Chrome</strong>. New versions arrive by themselves.</p></div></li>
          <li><span class="step-number">02</span><div><h3>Or load the ZIP by hand</h3><p>Extract the release ZIP somewhere permanent, open <code class="cmd">chrome://extensions</code>, turn on <strong>Developer mode</strong>, click <strong>Load unpacked</strong> and select the folder containing <code class="cmd">manifest.json</code>. This copy does not update itself.</p><button class="copy-address" data-copy="chrome://extensions" data-track="copy_command" data-track-command="chrome-extensions" type="button"><Icon name="copy" size={14} /> Copy chrome://extensions</button></div></li>
          <li><span class="step-number">03</span><div><h3>Connect your local memory</h3><p>Start local Imprint. Open the extension and choose a workspace. If Imprint uses a custom port, update the address in <strong>Settings</strong>.</p></div></li>
          <li><span class="step-number">04</span><div><h3>Pin it. Preview it. Save it.</h3><p>Pin Imprint Capture from Chrome’s Extensions menu. On a page, choose a capture action, then review and save. Use <strong>Search</strong> or <strong>Record meeting</strong> to continue in the dashboard.</p></div></li>
        </ol>
      </div>
    </section>

    <section class="section" id="coming-soon">
      <div class="wrap"><div class="eyebrow">Coming soon</div><h2 class="mt-3 text-3xl sm:text-4xl font-bold tracking-tight">More of your world,<br />one memory.</h2><p class="mt-4 max-w-2xl text-[color:var(--color-text-muted)]">This preview supports page and file capture, OCR, search, and meeting setup. These integrations are planned and are not enabled in the downloadable extension yet.</p>
        <div class="grid gap-4 mt-9 sm:grid-cols-2 lg:grid-cols-3">{comingSoon.map((item) => <article class="card p-6"><div class="flex justify-between items-center gap-3"><Icon name={item.icon} size={21} /><span class="soon-badge">Coming soon</span></div><h3 class="mt-5 font-semibold text-lg">{item.title}</h3><p class="mt-2 text-sm text-[color:var(--color-text-muted)]">{item.body}</p></article>)}</div>
      </div>
    </section>

    <section class="section border-t border-[color:var(--color-border)]"><div class="wrap grid gap-9 md:grid-cols-2"><div><h2 class="text-lg font-semibold">What leaves my browser?</h2><p class="mt-3 text-sm text-[color:var(--color-text-muted)]">Only the text, link, file or screenshot you choose to save, and only to Imprint on your computer. The extension reads a page only when you open it there, does not read cookies, passwords or history, and has no analytics. Captures then follow your workspace’s sync and model settings, including any remote providers you have chosen. <a href="/privacy/#extension" class="underline underline-offset-2">Privacy policy</a></p></div><div><h2 class="text-lg font-semibold">How do I update it?</h2><p class="mt-3 text-sm text-[color:var(--color-text-muted)]">From the Chrome Web Store, Chrome updates it for you. A copy loaded from the ZIP does not: download the latest ZIP, replace the files in the same folder, then click <strong>Reload</strong> for Imprint Capture in <code class="cmd">chrome://extensions</code>. Keeping the same folder keeps the extension ID and settings.</p></div><div><h2 class="text-lg font-semibold">Is there a Firefox version?</h2><p class="mt-3 text-sm text-[color:var(--color-text-muted)]">The same extension runs in Firefox 140 or later. The <strong>Firefox add-on</strong> button installs the latest Mozilla-signed build when you open it in Firefox; it does not update itself, so install newer builds the same way. Each release's <code class="cmd">-unsigned.xpi</code> is for Developer Edition, Nightly or a temporary load.</p></div></div></section>
  </main>
  <Footer />
</Landing>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((button) => {
    button.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(button.dataset.copy || '');
        const original = button.innerHTML;
        button.textContent = 'Copied';
        setTimeout(() => {button.innerHTML = original;}, 1800);
      } catch {button.textContent = 'Open chrome://extensions in the address bar';}
    });
  });
</script>

<style>
  .preview-badge, .soon-badge { border: 1px solid var(--color-border-strong); border-radius: 999px; padding: .2rem .55rem; font-size: .65rem; line-height: 1.4; font-weight: 500; letter-spacing: .025em; text-transform: none; color: var(--color-text-muted); }
  .capture-illustration { position: relative; padding: 0 0 3rem; min-width: 0; }
  .browser-frame { overflow: hidden; }
  .browser-bar { display: flex; align-items: center; gap: .8rem; padding: .9rem; border-bottom: 1px solid var(--color-border); background: var(--color-surface-2); }
  .window-dots { display: flex; gap: 4px; }.window-dots i { width: 6px; height: 6px; background: var(--color-border-strong); border-radius: 50%; }
  .browser-address { display: flex; align-items: center; gap: .5rem; flex: 1; min-width: 0; overflow: hidden; white-space: nowrap; font: .65rem var(--font-mono); color: var(--color-text-dim); }
  .article-sample { padding: 2rem 2rem 10rem; }.sample-label { font: .6rem var(--font-mono); letter-spacing: .15em; color: var(--color-text-dim); }
  .article-sample h2 { margin: 1rem 0; font-size: 1.65rem; font-weight: 700; line-height: 1.2; letter-spacing: -.04em; }.article-sample p { font-size: .8rem; line-height: 1.8; color: var(--color-text-muted); margin: .8rem 0; max-width: 19rem; }.article-sample mark { background: #ececec; color: inherit; padding: .1rem 0; }
  .sample-lines { display: grid; gap: .5rem; margin-top: 1.2rem; max-width: 17rem; }.sample-lines i { height: 4px; background: var(--color-border); border-radius: 3px; }.sample-lines i:last-child { width: 62%; }
  .capture-panel { position: absolute; right: -.5rem; bottom: 6rem; width: min(290px, 84%); border: 1px solid var(--color-border); border-radius: 14px; padding: 1.25rem; background: var(--color-surface); box-shadow: 0 18px 45px #0002; }
  .capture-connected { margin-top: 1.2rem; display: flex; align-items: center; gap: .4rem; color: var(--color-text-muted); font-size: .65rem; }.capture-connected span { height: 5px; width: 5px; border-radius: 50%; background: var(--color-success); }
  .mock-field { background: var(--color-surface-2); border: 1px solid var(--color-border); padding: .6rem .7rem; border-radius: 6px; font-size: .75rem; }.mock-save { display: flex; justify-content: center; align-items: center; gap: .4rem; padding: .7rem; margin-top: 1rem; border-radius: 6px; background: #fff; color: #111; font-size: .75rem; font-weight: 600; }
  .install-steps { display: grid; gap: 2rem; }.install-steps li { display: flex; align-items: flex-start; gap: 1.3rem; }.step-number { flex: none; font: .7rem var(--font-mono); padding-top: .25rem; color: var(--color-text-dim); }.install-steps h3 { font-size: 1.05rem; font-weight: 600; }.install-steps p { margin-top: .5rem; font-size: .875rem; line-height: 1.75; color: var(--color-text-muted); }.copy-address { display: inline-flex; align-items: center; gap: .5rem; margin-top: .8rem; padding: .5rem .7rem; border: 1px solid var(--color-border-strong); border-radius: 6px; font-size: .75rem; cursor: pointer; }
  @media (max-width: 380px) { .article-sample { padding: 1.4rem 1.4rem 11rem; }.capture-panel { right: 0; }.browser-address { font-size: .55rem; } }
</style>
