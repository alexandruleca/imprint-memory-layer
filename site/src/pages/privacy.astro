---
import Landing from '../layouts/Landing.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Icon from '../components/Icon.astro';

const title = 'Privacy policy — Imprint';
const description = 'What the Imprint app, the Imprint Capture browser extension, the sync relay and this website collect, where it goes and how to remove it.';
const updated = '20 November 2026';
const repo = 'https://github.com/alexandruleca/imprint-memory-layer';

const summary = [
  {icon: 'server', text: 'Imprint runs on your computer. There is no account, and the app sends us no telemetry.'},
  {icon: 'globe', text: 'The browser extension reads a page only when you ask it to, and sends what you save only to Imprint on your own computer.'},
  {icon: 'lock', text: 'Sync between your devices is end-to-end encrypted. The relay forwards ciphertext and keeps none of it.'},
  {icon: 'monitor', text: 'This website uses Google Analytics to count visits, downloads and clicks.'},
] as const;

const contents = [
  ['extension', 'Imprint Capture extension'],
  ['app', 'The Imprint app'],
  ['relay', 'Sync relay'],
  ['website', 'This website'],
  ['sharing', 'Sharing and selling'],
  ['choices', 'Your choices'],
  ['changes', 'Changes and contact'],
] as const;
---

<Landing title={title} description={description} pathname="/privacy/">
  <Nav />
  <main class="wrap max-w-3xl py-16 sm:py-20">
    <div class="eyebrow"><Icon name="shield" size={14} /> Privacy</div>
    <h1 class="mt-4 text-4xl sm:text-5xl font-extrabold tracking-tight">Privacy policy</h1>
    <p class="lede max-w-2xl">
      Imprint is an open-source project maintained by Alexandru Leca. This policy covers the Imprint app, the
      Imprint Capture extension for Chrome and Firefox, the public sync relay at
      <code class="cmd">sync.alexandruleca.com</code> and this website. “We” means the project’s maintainers.
    </p>
    <p class="mt-3 text-sm text-[color:var(--color-text-dim)]">Last updated {updated}</p>

    <ul class="mt-10 grid gap-3 sm:grid-cols-2">
      {summary.map((item) => (
        <li class="card p-5 flex gap-3.5">
          <span class="icon-tile shrink-0"><Icon name={item.icon} size={18} /></span>
          <p class="text-[15px] leading-relaxed text-[color:var(--color-text-muted)]">{item.text}</p>
        </li>
      ))}
    </ul>

    <nav class="mt-10 card p-5" aria-label="On this page">
      <div class="text-xs font-semibold uppercase tracking-[0.14em] text-[color:var(--color-text-dim)]">On this page</div>
      <ol class="mt-3 sm:columns-2 gap-x-8 text-sm">
        {contents.map(([id, label]) => (
          <li class="py-0.5 break-inside-avoid"><a href={`#${id}`} class="text-[color:var(--color-text-muted)] hover:text-ink underline-offset-4 hover:underline">{label}</a></li>
        ))}
      </ol>
    </nav>

    <article class="policy mt-4">
      <section id="extension">
        <h2>Imprint Capture extension</h2>
        <p>
          Imprint Capture saves what you are looking at in the browser into Imprint on your computer. The same
          extension is published for Chrome and for Firefox and behaves the same in both.
        </p>

        <h3>What it reads, and when</h3>
        <p>
          The extension does nothing until you open it from the toolbar or with a shortcut you set. It then reads
          the address and title of the tab you are on, to name the capture and offer the actions that suit the
          page. When you choose an action, it reads only what that action needs:
        </p>
        <ul>
          <li><strong>Page text</strong>: the readable text of the open page. Forms, editable fields, hidden text and navigation are left out.</li>
          <li><strong>Selection</strong>: the passage you highlighted.</li>
          <li><strong>Link</strong>: the page’s address, which your local Imprint then fetches itself, without your browser’s cookies.</li>
          <li><strong>File in this tab</strong>: the PDF or document the tab shows, or a same-site attachment link you selected, downloaded with the page’s own session. On a Google Doc or Sheet, the extension asks Google for a DOCX or XLSX export of that document, as the File → Download menu would.</li>
          <li><strong>Upload a file</strong>: the file you choose, drop or paste.</li>
          <li><strong>Screenshot text</strong>: an image of the visible part of the tab, or of the whole page, which the extension scrolls one screen at a time and then returns to where it was.</li>
        </ul>
        <p>
          You see a preview and can edit the title before anything is saved. The extension does not read your
          browsing history, cookies, passwords or other tabs, does not run on pages in the background, and loads
          no code from the internet. It contains no analytics or tracking.
        </p>

        <h3>Where it goes</h3>
        <p>
          The extension’s only network destination is the Imprint app on your own computer, at
          <code>http://127.0.0.1</code> (port 8420 unless you change it in Settings). It refuses any other address
          and any redirect, and sends no cookies to it. It sends your local Imprint:
        </p>
        <ul>
          <li>the text, link, file or screenshot you chose to save, with its title, address and the workspace and project you picked;</li>
          <li>requests for your list of workspaces and for the status of your last capture;</li>
          <li>the extension’s own installation ID, which Imprint uses to accept requests from the extension and to refuse requests from websites.</li>
        </ul>
        <p>
          Nothing you capture is sent to us or to any other server by the extension. <strong>Search</strong> and
          <strong>Record meeting</strong> open your local Imprint dashboard in a new tab; recording and
          transcription happen in the Imprint app on your computer.
        </p>

        <h3>What it keeps in the browser</h3>
        <p>
          The extension stores its settings in the browser’s local extension storage, which websites cannot read:
          the address of your local Imprint, the workspace and project you last chose, your six most recent project
          names, and the ID, title and destination of your last capture so the popup can show its progress. The
          last capture is forgotten after a day or when you dismiss it. All of it is deleted when you remove the
          extension.
        </p>

        <h3>Chrome Web Store and Firefox add-on policies</h3>
        <p>
          The use of information received from browser APIs adheres to the
          <a href="https://developer.chrome.com/docs/webstore/program-policies/user-data-faq">Chrome Web Store User Data Policy</a>,
          including the Limited Use requirements, and to Mozilla’s add-on policies. Data the extension handles is
          used only to save it to your Imprint at your request. It is not sold, not used for advertising, not
          used to determine creditworthiness or for lending, and not read by people.
        </p>
      </section>

      <section id="app">
        <h2>The Imprint app</h2>
        <p>
          The app, its dashboard and its MCP server run on your computer and keep their data in Imprint’s data
          folder there. There is no Imprint account, and the app sends no usage data, crash reports or analytics.
          What you capture with the extension is kept in your local queue history and in the workspace you chose
          until you delete it. A file you upload is kept in the local queue only while a job can use it: until it
          is indexed, or for a week after its job failed or was cancelled, so you can retry it.
        </p>
        <p>The app connects to the internet only for these things:</p>
        <ul>
          <li><strong>Downloads and updates.</strong> Setup and first use download models and components (from Hugging Face and the projects that publish them), and the app checks GitHub for new releases. These requests send nothing of yours.</li>
          <li><strong>Pages you ask it to fetch</strong>, such as a captured <strong>Link</strong> or <code>imprint ingest-url</code>, and their later refreshes.</li>
          <li><strong>Sync</strong>, only between devices you pair (see <a href="#relay">Sync relay</a>).</li>
          <li><strong>Cloud model providers</strong>, only if you choose one (Anthropic, OpenAI, Gemini or your own server) for tagging, summaries or chat. Credentials are redacted from what is sent, but the content you send is handled under that provider’s own privacy policy.</li>
        </ul>
      </section>

      <section id="relay">
        <h2>Sync relay</h2>
        <p>
          When you pair devices, they meet through a relay: the public one at <code>sync.alexandruleca.com</code>,
          run by the maintainer, or one you run yourself. Each session is end-to-end encrypted with a key derived
          from its one-time code, which never crosses the relay, so the relay cannot read your memories, facts,
          files, device names or recordings.
        </p>
        <p>
          While it forwards a session the relay sees the session’s room ID, the two devices’ IP addresses, and the
          number, size and timing of the encrypted frames. The relay software writes none of this to disk and keeps
          only a running count of sessions relayed since it started, which its health check reports. The relay’s
          web page counts visits with Google Analytics, as this website does; the sync connection itself does not.
          To keep even that metadata to yourself, <a href="/docker/">run your own relay</a> or move snapshots
          offline.
        </p>
      </section>

      <section id="website">
        <h2>This website</h2>
        <p>
          This website is a static site hosted on GitHub Pages. GitHub receives your IP address and browser details
          when it serves the pages and release downloads, under
          <a href="https://docs.github.com/site-policy/privacy-policies/github-general-privacy-statement">GitHub’s privacy statement</a>.
        </p>
        <p>
          We use <strong>Google Analytics 4</strong> to understand which pages are read and which downloads are
          used. It records the pages you view, the page you came from, your browser, device and approximate location
          (which Google derives from your IP address), and these actions: downloading a release file, copying an
          install command, switching a tab, opening an answer or menu, choosing an option, and clicking a link or
          button. It sets first-party cookies named <code>_ga</code> and <code>_ga_*</code>. Google processes this
          data under <a href="https://policies.google.com/privacy">Google’s privacy policy</a>; we see only
          aggregated reports and do not combine them with anything else.
        </p>
        <p>
          Fonts are loaded from Google Fonts, so Google also receives your IP address and browser details when a page
          loads. On the home page, your browser checks the public relay’s status at
          <code>sync.alexandruleca.com/health</code> every 30 seconds while the tab is visible. The download page reads
          your operating system, processor architecture and graphics card name in your browser to suggest an
          installer; they stay in your browser. The website has no forms and no sign-in, and asks for no personal
          information.
        </p>
      </section>

      <section id="sharing">
        <h2>Sharing and selling</h2>
        <p>
          We do not sell or rent personal data, do not use it for advertising, and do not share it with anyone
          except as described above: Google for this website’s analytics and fonts, GitHub for hosting, and the
          model providers or relays you choose yourself. Imprint is not directed at children under 13.
        </p>
      </section>

      <section id="choices">
        <h2>Your choices</h2>
        <ul>
          <li><strong>Delete captures.</strong> Remove a captured source from the dashboard or with Imprint’s purge workflow. Deletions reach your paired devices.</li>
          <li><strong>Remove the extension.</strong> Removing it from the browser deletes its settings.</li>
          <li><strong>Keep content local.</strong> Leave sync and cloud providers off, which is the default, or run your own relay.</li>
          <li><strong>Opt out of analytics.</strong> Block cookies for this site, use your browser’s tracking protection, or install the <a href="https://tools.google.com/dlpage/gaoptout">Google Analytics opt-out add-on</a>.</li>
        </ul>
      </section>

      <section id="changes">
        <h2>Changes and contact</h2>
        <p>
          When this policy changes, the date at the top changes with it, and the history of this page is public in
          the <a href={`${repo}/commits/main/site/src/pages/privacy.astro`}>project’s repository</a>. For questions
          or requests about privacy, <a href={`${repo}/issues`}>open an issue on GitHub</a> or contact
          <a href="https://github.com/alexandruleca">@alexandruleca</a>. Report security problems privately as
          described in the <a href={`${repo}/blob/main/SECURITY.md`}>security policy</a>.
        </p>
      </section>
    </article>
  </main>
  <Footer />
</Landing>

<style>
  .policy section { padding-top: 2.75rem; }
  .policy h2 { font-size: 1.6rem; font-weight: 700; letter-spacing: -0.02em; line-height: 1.2; }
  .policy h3 { margin-top: 1.75rem; font-size: 1.05rem; font-weight: 600; }
  .policy p, .policy ul { margin-top: 0.85rem; color: var(--color-text-muted); line-height: 1.75; }
  .policy ul { padding-left: 1.25rem; list-style: disc; display: grid; gap: 0.4rem; }
  .policy li::marker { color: var(--color-text-dim); }
  .policy strong { color: var(--color-text); font-weight: 600; }
  .policy a { color: var(--color-ink); text-decoration: underline; text-underline-offset: 3px; }
  .policy code { font-family: var(--font-mono); font-size: 0.85em; background: var(--color-surface-2); border: 1px solid var(--color-border); border-radius: 4px; padding: 0 4px; overflow-wrap: anywhere; }
</style>
