---
import Landing from '../layouts/Landing.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Hosts from '../components/Hosts.astro';
import Benefits from '../components/Benefits.astro';
import Sync from '../components/Sync.astro';
import Workspaces from '../components/Workspaces.astro';
import Capture from '../components/Capture.astro';
import Recall from '../components/Recall.astro';
import BenchSummary from '../components/BenchSummary.astro';
import ArchDiagram from '../components/ArchDiagram.astro';
import Install from '../components/Install.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';
import benchmarks from '../data/benchmarks.json';

const title = 'Imprint — Shared MCP Memory for Claude Code, Cursor, Copilot';
const description =
  `One persistent, searchable memory for your AI coding agents, shared across sessions, tools, machines and teammates. Local-first and open source. ${benchmarks.runCount} measured benchmark trials with published retrieval, token and cost evidence.`;
---

<Landing title={title} description={description} pathname="/">
  <Nav />
  <main>
    <Hero />
    <Hosts />
    <Benefits />
    <Sync />
    <Workspaces />
    <Capture />
    <Recall />
    <BenchSummary />
    <ArchDiagram />
    <Install />
    <CTA />
  </main>
  <Footer />
</Landing>
