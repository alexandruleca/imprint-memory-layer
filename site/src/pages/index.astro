---
import Landing from '../layouts/Landing.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Hosts from '../components/Hosts.astro';
import Benefits from '../components/Benefits.astro';
import Sync from '../components/Sync.astro';
import Workspaces from '../components/Workspaces.astro';
import Capture from '../components/Capture.astro';
import Recall from '../components/Recall.astro';
import ArchDiagram from '../components/ArchDiagram.astro';
import Install from '../components/Install.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';

const title = 'Imprint — Shared MCP Memory for Claude Code, Cursor, Copilot';
const description =
  'Persistent project memory for your AI coding agents. Search locally, sync workspaces with end-to-end encryption, and carry shared knowledge across sessions, tools and devices. Open source.';
---

<Landing title={title} description={description} pathname="/">
  <Nav />
  <main>
    <Hero />
    <Hosts />
    <Benefits />
    <Sync />
    <Workspaces />
    <Capture />
    <Recall />
    <ArchDiagram />
    <Install />
    <CTA />
  </main>
  <Footer />
</Landing>
